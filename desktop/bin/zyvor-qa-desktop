#!/usr/bin/env bash
# Zyvor QA Agent Desktop — npm-style CLI launcher (modeled on hypercluster-desktop)
set -euo pipefail

export ZQ_DESKTOP_INVOKED_AS="${ZQ_DESKTOP_INVOKED_AS:-$(basename "$0")}"

if command -v realpath >/dev/null 2>&1; then
  SCRIPT_DIR="$(dirname "$(realpath "$0")")"
else
  SCRIPT_DIR="$(dirname "$(readlink "$0" 2>/dev/null || echo "$0")")"
fi

DESKTOP_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
TAURI_DIR="$DESKTOP_ROOT/src-tauri"
CMD="${1:-dev}"

usage() {
  cat <<EOF
Usage: ${ZQ_DESKTOP_INVOKED_AS} [command] [options]

Commands:
  dev      Start Tauri dev server (default)
  build    Build production native app bundle
  run      Launch the built .app (macOS) or binary
  help     Show this help

Examples:
  ${ZQ_DESKTOP_INVOKED_AS}              # same as dev
  ${ZQ_DESKTOP_INVOKED_AS} dev
  ${ZQ_DESKTOP_INVOKED_AS} build
  npm install -g ./desktop && ${ZQ_DESKTOP_INVOKED_AS}
EOF
}

ensure_deps() {
  if [[ ! -d "$DESKTOP_ROOT/node_modules" ]]; then
    echo "→ Installing desktop dependencies…" >&2
    (cd "$DESKTOP_ROOT" && npm install)
  fi
}

tauri() {
  ensure_deps
  (cd "$DESKTOP_ROOT" && npm run tauri -- "$@")
}

launch_built() {
  local app=""
  if [[ "$OSTYPE" == darwin* ]]; then
    app="$(find "$TAURI_DIR/target" -path '*/bundle/macos/*.app' -type d 2>/dev/null | head -1 || true)"
    if [[ -n "$app" ]]; then
      exec open "$app"
    fi
  fi

  local bin="$TAURI_DIR/target/release/zyvor-qa-desktop"
  if [[ -x "$bin" ]]; then
    exec "$bin" "${@:2}"
  fi

  bin="$TAURI_DIR/target/debug/zyvor-qa-desktop"
  if [[ -x "$bin" ]]; then
    exec "$bin" "${@:2}"
  fi

  echo "❌  No built Zyvor QA Agent Desktop app found." >&2
  echo "    Run: ${ZQ_DESKTOP_INVOKED_AS} build" >&2
  exit 1
}

case "$CMD" in
  -h|--help|help)
    usage
    ;;
  dev)
    shift || true
    tauri dev "$@"
    ;;
  build)
    shift || true
    tauri build "$@"
    ;;
  run)
    launch_built "$@"
    ;;
  *)
    echo "Unknown command: $CMD" >&2
    usage
    exit 1
    ;;
esac
