# LLM Provider (openai | anthropic | azure | ollama | google)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# Provider API keys (set the one matching LLM_PROVIDER)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# GitHub
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
ZYVOR_PRODUCT_REPO=owner/zyvor-monorepo

# Zyvor targets
ZYVOR_BASE_URL=https://zyvor.dev
ZYVOR_STAGING_URL=
ZYVOR_TEST_USER=
ZYVOR_TEST_PASSWORD=

# Optional feature flags (Phase 2+)
ENABLE_REGRESSION=false
ENABLE_AUTOFIX=false

# Notification channels (Phase 3)
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
