// Copy into your own repo as Jenkinsfile (or merge the stage into an existing pipeline).
// Full env var / exit-code / summary.json contract:
// https://github.com/hypersdk/ZyAIQAAgent/blob/main/docs/tutorials/15-external-cicd-integration.md
//
// `args '--entrypoint=""'` clears the image's baked-in ENTRYPOINT so the `sh`
// step below runs directly instead of being appended as args to it.
pipeline {
  agent {
    docker {
      image 'ghcr.io/hypersdk/zyaiqaagent:v0.3.0'
      args '--entrypoint=""'
    }
  }
  environment {
    ZYVOR_BASE_URL = "${params.STAGING_URL}"
    ZYVOR_ENV = 'development' // 'production' enforces ZYVOR_TARGET_ALLOWLIST for private targets
  }
  stages {
    stage('QA Smoke') {
      steps {
        sh 'zyvor-qa test --grep @smoke'
      }
    }
  }
  post {
    always {
      archiveArtifacts artifacts: 'reports/**, test-results/**, screenshots/**, videos/**, traces/**', allowEmptyArchive: true
    }
  }
}
