<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Zyvor Argus — Live data</title>
<style>
  :root { --ok: #0ca30c; --bad: #d03b3b; --ink: #f1f5f9; --ink2: #98989d; --line: rgba(255,255,255,0.1); --surface: #1a1a19; }
  * { box-sizing: border-box; }
  body { margin: 0; background: #0d0d0d; color: var(--ink); font-family: -apple-system, "Segoe UI", Inter, sans-serif; font-size: 14px; padding: 28px; }
  h1 { font-size: 20px; margin: 0 0 4px; }
  .meta { color: var(--ink2); font-size: 13px; margin-bottom: 20px; }
  .summary { display: flex; gap: 14px; margin-bottom: 22px; flex-wrap: wrap; }
  .tile { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 12px 18px; }
  .tile .k { color: var(--ink2); font-size: 12px; text-transform: uppercase; }
  .tile .v { font-size: 22px; font-weight: 700; }
  .pass { color: var(--ok); } .fail { color: var(--bad); }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); font-size: 13px; }
  th { color: var(--ink2); }
  .chip { display: inline-block; padding: 1px 9px; border-radius: 999px; font-size: 11px; font-weight: 700; border: 1px solid currentColor; }
  code { font-family: ui-monospace, Menlo, monospace; font-size: 12px; }
  img { max-width: 640px; width: 100%; border: 1px solid var(--line); border-radius: 10px; margin-top: 12px; }
  @media print { body { background: #fff; color: #111; } }
</style>
</head>
<body>
  <h1>Zyvor Argus — Live data / WebSocket</h1>
  <div class="meta">{{ url }} · {{ generated_at }}</div>
  <div class="summary">
    <div class="tile"><div class="k">Passed</div><div class="v pass">{{ data.passed }}</div></div>
    <div class="tile"><div class="k">Failed</div><div class="v {{ 'fail' if data.failed else '' }}">{{ data.failed }}</div></div>
    {% if data.ws %}<div class="tile"><div class="k">WS messages</div><div class="v">{{ data.ws.messages }}</div></div>{% endif %}
    {% if data.live %}<div class="tile"><div class="k">Page health</div><div class="v {{ 'pass' if data.live.classification == 'ok' else 'fail' }}">{{ data.live.classification }}</div></div>{% endif %}
  </div>
  <table>
    <tr><th>Check</th><th>Result</th><th>Detail</th></tr>
    {% for c in data.checks %}
    <tr>
      <td>{{ c.name }}</td>
      <td><span class="chip {{ 'pass' if c.ok else 'fail' }}">{{ 'OK' if c.ok else 'FAIL' }}</span></td>
      <td><code>{{ c.detail or '' }}</code></td>
    </tr>
    {% endfor %}
  </table>
  {% if data.shot_url %}<img src="{{ data.shot_url }}" alt="page screenshot">{% endif %}
</body>
</html>
