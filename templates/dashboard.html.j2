<script>
"use strict";

// Attach X-CSRF-Token to every mutating same-origin fetch() automatically,
// so none of the call sites below need to be touched individually. The
// token is read from the (non-HttpOnly) zyvor_qa_csrf cookie set alongside
// the session cookie at login; see orchestrator/dashboard/auth.py.
(function () {
  const realFetch = window.fetch.bind(window);
  window.fetch = function (input, init) {
    const method = ((init && init.method) || "GET").toUpperCase();
    if (method !== "GET" && method !== "HEAD") {
      const match = document.cookie.match(/(?:^|;\s*)zyvor_qa_csrf=([^;]+)/);
      if (match) {
        init = init || {};
        init.headers = Object.assign({}, init.headers, {"X-CSRF-Token": match[1]});
      }
    }
    return realFetch(input, init);
  };
})();

const REFRESH = {{ refresh_interval_ms }};
const $ = (id) => document.getElementById(id);
let soundOn = localStorage.getItem("zyvor-sound") !== "off";
let lastSync = null;
let drawerPod = null;
let drawerHover = false;

function esc(s) {
  return String(s ?? "").replace(/[&<>"']/g, (c) => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}

function rel(seconds) {
  if (seconds == null) return "—";
  if (seconds < 90) return seconds + "s";
  if (seconds < 5400) return Math.round(seconds / 60) + "m";
  if (seconds < 172800) return Math.round(seconds / 3600) + "h";
  return Math.round(seconds / 86400) + "d";
}
function relIso(iso) {
  if (!iso) return "—";
  return rel(Math.max(0, (Date.now() - new Date(iso).getTime()) / 1000 | 0)) + " ago";
}
function tspan(iso) {
  return '<span title="' + esc(iso || "") + '">' + relIso(iso) + "</span>";
}
function fmtMem(bytes) {
  if (bytes == null) return null;
  if (bytes >= 1024 ** 3) return (bytes / 1024 ** 3).toFixed(1) + "Gi";
  return Math.round(bytes / 1024 ** 2) + "Mi";
}
function fmtCpu(m) {
  if (m == null) return null;
  return m >= 1000 ? (m / 1000).toFixed(1) + " cpu" : Math.round(m) + "m";
}
function toast(kind, ok, sub) {
  const host = $("toasts");
  const el = document.createElement("div");
  el.className = "toast " + (ok ? "ok" : "bad");
  el.innerHTML = "<span>" + (ok ? "✅" : "❌") + '</span><span><span class="t-kind">' + esc(kind) + "</span><br><span class=\"t-sub\">" + esc(sub) + "</span></span>";
  host.appendChild(el);
  setTimeout(() => el.remove(), 7000);
}

/* minimal 5-field cron "next fire" — supports *, numbers, lists, and steps */
function cronNext(expr) {
  const parts = (expr || "").trim().split(/\s+/);
  if (parts.length !== 5) return null;
  const parse = (f, min, max) => {
    const out = new Set();
    for (const piece of f.split(",")) {
      const m = piece.match(/^(\*|\d+)(?:\/(\d+))?$/);
      if (!m) return null;
      const step = m[2] ? parseInt(m[2], 10) : 1;
      const start = m[1] === "*" ? min : parseInt(m[1], 10);
      const end = m[1] === "*" ? max : (m[2] ? max : start);
      for (let v = start; v <= end; v += step) out.add(v);
    }
    return out;
  };
  const fields = [parse(parts[0],0,59), parse(parts[1],0,23), parse(parts[2],1,31), parse(parts[3],1,12), parse(parts[4],0,6)];
  if (fields.some(f => !f)) return null;
  const t = new Date(); t.setUTCSeconds(0, 0); t.setUTCMinutes(t.getUTCMinutes() + 1);
  for (let i = 0; i < 366 * 24 * 60; i++) {
    if (fields[0].has(t.getUTCMinutes()) && fields[1].has(t.getUTCHours()) &&
        fields[2].has(t.getUTCDate()) && fields[3].has(t.getUTCMonth() + 1) &&
        fields[4].has(t.getUTCDay())) return t;
    t.setUTCMinutes(t.getUTCMinutes() + 1);
  }
  return null;
}
function countdown(expr) {
  const next = cronNext(expr);
  if (!next) return null;
  const s = Math.max(0, (next.getTime() - Date.now()) / 1000 | 0);
  const h = s / 3600 | 0, m = (s % 3600) / 60 | 0;
  return h > 0 ? h + "h " + m + "m" : m + "m";
}

function podStatus(p) {
  const phase = p.phase || "Unknown";
  if (phase === "Succeeded") return { color: "var(--status-ok)", label: "Succeeded" };
  if (phase === "Failed") return { color: "var(--status-error)", label: "Failed" };
  if (phase === "Pending") return { color: "var(--status-info)", label: "Pending" };
  if (phase === "Running" && p.total && p.ready < p.total) return { color: "var(--status-warn)", label: "Running (not ready)" };
  if (phase === "Running") return { color: "var(--status-ok)", label: "Running" };
  return { color: "var(--status-warn)", label: phase };
}

/* dynamic favicon + tab title reflecting status */
const STATUS_DOT = { go: "#22c55e", degraded: "#f59e0b", down: "#ef4444", offline: "#8e8e93" };
function setFavicon(status) {
  const canvas = document.createElement("canvas");
  canvas.width = canvas.height = 32;
  const ctx = canvas.getContext("2d");
  ctx.fillStyle = STATUS_DOT[status] || STATUS_DOT.offline;
  ctx.beginPath(); ctx.arc(16, 16, 11, 0, Math.PI * 2); ctx.fill();
  let link = document.querySelector('link[rel="icon"]');
  if (!link) { link = document.createElement("link"); link.rel = "icon"; document.head.appendChild(link); }
  link.href = canvas.toDataURL("image/png");
}

function renderHero(overview, pods, runs) {
  const hero = $("hero");
  const status = overview.status || "offline";
  hero.dataset.status = status;
  const titles = { go: "ALL SYSTEMS GO", degraded: "DEGRADED", down: "SYSTEMS DOWN", offline: "CLUSTER OFFLINE" };
  $("banner-title").textContent = titles[status] || status.toUpperCase();
  setFavicon(status);
  document.title = (status === "go" ? "🟢" : status === "degraded" ? "🟡" : status === "down" ? "🔴" : "⚪")
    + " " + (titles[status] || status) + " · Zyvor Argus";
  if (overview.server) {
    $("server-info").innerHTML = "argus v" + esc(overview.server.version)
      + ' · up <span title="' + esc(overview.server.started_at) + '">'
      + rel(Math.max(0, (Date.now() - new Date(overview.server.started_at).getTime()) / 1000 | 0)) + "</span>";
  }
  $("banner-sub").textContent = overview.cluster && overview.cluster.available
    ? "Kubernetes connected · namespace " + overview.namespace
    : "no Kubernetes API — QA history only";
  $("ns").textContent = overview.namespace ? "· ns/" + overview.namespace : "";

  const podList = (pods && pods.available && pods.pods) || [];
  const healthy = podList.filter((p) => p.phase === "Running" && (!p.total || p.ready >= p.total)).length;
  $("stat-pods").textContent = pods && pods.available ? String(podList.length) : "—";
  $("stat-pods-sub").textContent = pods && pods.available ? healthy + " healthy" : "cluster offline";

  const deps = (overview.workloads && overview.workloads.deployments) || [];
  const ready = deps.reduce((a, d) => a + d.ready, 0);
  const desired = deps.reduce((a, d) => a + d.desired, 0);
  $("stat-replicas").textContent = deps.length ? ready + "/" + desired : "—";
  $("stat-replicas-sub").textContent = deps.length ? deps.length + " deployment" + (deps.length === 1 ? "" : "s") : "cluster offline";

  const latest = runs && runs[0];
  $("stat-run").textContent = latest ? latest.passed + "/" + latest.total : "—";
  $("stat-run").style.color = latest ? (latest.failed > 0 ? "var(--status-error)" : "var(--status-ok)") : "";
  $("stat-run-sub").textContent = latest ? relIso(latest.timestamp) : "no history";

  // pass rate over history + trend vs the older half
  const rated = (runs || []).filter((r) => r.total > 0);
  if (rated.length) {
    const rate = (list) => list.reduce((a, r) => a + r.passed / r.total, 0) / list.length;
    const overall = rate(rated) * 100;
    const half = Math.ceil(rated.length / 2);
    const newer = rate(rated.slice(0, half)) * 100;
    const older = rated.length > half ? rate(rated.slice(half)) * 100 : newer;
    const delta = newer - older;
    const arrow = Math.abs(delta) < 0.5 ? "" : delta > 0 ? ' <span class="trend-up">↑</span>' : ' <span class="trend-down">↓</span>';
    $("stat-rate").innerHTML = overall.toFixed(0) + "%" + arrow;
    $("stat-rate").style.color = overall >= 99 ? "var(--status-ok)" : overall >= 90 ? "" : "var(--status-warn)";
    $("stat-rate-sub").textContent = "last " + rated.length + " run" + (rated.length === 1 ? "" : "s");
  } else {
    $("stat-rate").textContent = "—";
  }

  const crons = (overview.workloads && overview.workloads.cronjobs) || [];
  const active = crons.find((c) => !c.suspend);
  const cd = active ? countdown(active.schedule) : null;
  $("stat-cron").textContent = cd ? "in " + cd : (active ? active.schedule : "—");
  $("stat-cron-sub").textContent = active ? "cron/" + active.name : "no cronjobs";
}

function renderWorkloads(w) {
  const el = $("workloads");
  if (!w || !w.available || (!w.deployments.length && !w.cronjobs.length)) {
    el.innerHTML = '<div class="empty">No workload data (cluster offline or empty namespace).</div>';
    return;
  }
  let html = "";
  for (const d of w.deployments) {
    const ok = d.ready >= d.desired && d.desired > 0;
    html += '<div class="glass card"><div class="k">deploy/' + esc(d.name) + '</div>'
      + '<div class="v" style="color:' + (ok ? "var(--status-ok)" : "var(--status-warn)") + '">' + d.ready + "/" + d.desired + '</div>'
      + '<div class="d">replicas ready</div></div>';
  }
  for (const c of w.cronjobs) {
    const cd = c.suspend ? null : countdown(c.schedule);
    html += '<div class="glass card"><div class="k">cron/' + esc(c.name) + '</div>'
      + '<div class="v">' + (c.suspend ? "suspended" : (cd ? "in " + cd : esc(c.schedule))) + '</div>'
      + '<div class="d">' + esc(c.schedule) + ' · last: ' + relIso(c.last_schedule)
      + (c.active ? ' · <b style="color:var(--status-warn)">running now</b>' : "") + '</div></div>';
  }
  el.innerHTML = html;
}

let podsCache = null;
function renderPods(data) {
  podsCache = data;
  const el = $("pods");
  if (!data.available) {
    el.innerHTML = '<div class="empty">Kubernetes API unreachable — start a cluster or set KUBECONFIG. '
      + 'The QA runs panel below still works.</div>';
    return;
  }
  const filter = $("pod-search").value.trim().toLowerCase();
  const pods = data.pods.filter((p) =>
    !filter || [p.name, p.node, p.phase, (p.images || []).join(" ")].join(" ").toLowerCase().includes(filter));
  if (!pods.length) {
    el.innerHTML = '<div class="empty">' + (filter ? "No pods match “" + esc(filter) + "”." : "No pods in namespace " + esc(data.namespace) + ".") + "</div>";
    return;
  }
  el.innerHTML = pods.map((p) => {
    const st = podStatus(p);
    const image = (p.images && p.images[0] || "").split("/").pop();
    const cpu = p.usage ? fmtCpu(p.usage.cpu_millicores) : null;
    const mem = p.usage ? fmtMem(p.usage.memory_bytes) : null;
    return '<div class="glass card pod" data-pod="' + esc(p.name) + '" title="click for logs">'
      + '<div class="row"><span class="dot" style="background:' + st.color + ';box-shadow:0 0 8px ' + st.color + '"></span>'
      + '<span class="name">' + esc(p.name) + '</span>'
      + '<span class="phase">' + esc(st.label) + '</span></div>'
      + '<div class="meta">'
      + '<span>ready <b>' + p.ready + "/" + p.total + '</b></span>'
      + '<span class="' + (p.restarts > 0 ? "restarts-bad" : "") + '">restarts <b>' + p.restarts + '</b></span>'
      + '<span>age <b>' + rel(p.age_seconds) + '</b></span>'
      + (cpu ? '<span>cpu <b>' + cpu + '</b></span>' : "")
      + (mem ? '<span>mem <b>' + mem + '</b></span>' : "")
      + (p.node ? '<span>node <b>' + esc(p.node) + '</b></span>' : "")
      + (image ? '<span><b>' + esc(image) + '</b></span>' : "")
      + '</div>'
      + (p.warnings && p.warnings.length ? '<div class="warn" title="' + esc(p.warnings.join("\n")) + '">⚠ ' + esc(p.warnings[p.warnings.length - 1]) + '</div>' : "")
      + '<div class="meta" style="margin-top:8px"><button class="dl-btn pod-restart" data-pod="' + esc(p.name) + '">⟳ restart</button></div>'
      + '</div>';
  }).join("");
  for (const card of el.querySelectorAll(".pod")) {
    card.addEventListener("click", () => openDrawer(card.dataset.pod));
  }
  for (const btn of el.querySelectorAll(".pod-restart")) {
    btn.addEventListener("click", async (ev) => {
      ev.stopPropagation();
      const pod = btn.dataset.pod;
      if (!confirm("Restart pod " + pod + "? Its controller will recreate it.")) return;
      const res = await fetch("/api/dashboard/pods/" + encodeURIComponent(pod), { method: "DELETE" });
      const data = await res.json();
      toast("restart pod", !!data.ok, data.ok ? pod + " deleted — recreating" : (data.error || "failed"));
      sync();
    });
  }
}
$("pod-search").addEventListener("input", () => { if (podsCache) renderPods(podsCache); });

/* test-health panel */
async function loadTestHealth() {
  try {
    const data = await fetch("/api/dashboard/tests").then((r) => r.json());
    const el = $("test-health");
