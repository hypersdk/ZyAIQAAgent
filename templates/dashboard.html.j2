function renderAskBubble(role, html, metaHtml) {
  const cls = role === "user" ? "ask-bubble user" : "ask-bubble assistant";
  return '<div class="' + cls + '">'
    + (metaHtml || "")
    + '<div class="ask-answer">' + html + "</div></div>";
}

function citationMarkdown(citations) {
  if (!citations || !citations.length) return "";
  return "\n\n## Sources\n" + citations.map((c, i) => {
    const bits = [c.title || c.document_id, c.section, c.source].filter(Boolean).join(" · ");
    return (i + 1) + ". " + bits + (c.url ? " — " + c.url : "");
  }).join("\n");
}

function lastAnswerMarkdown() {
  if (!askLastPayload) return "";
  const p = askLastPayload;
  let md = "# Zyvor knowledge answer\n\n" + (p.answer || "") + "\n";
  md += "\nConfidence: " + (p.confidence || "unknown") + "\n";
  if (p.insufficient_context) md += "\nInsufficient context: true\n";
  if (p.missing_information && p.missing_information.length) {
    md += "\nMissing information:\n" + p.missing_information.map((m) => "- " + m).join("\n") + "\n";
  }
  if (p.recommended_action) md += "\nRecommended action: " + p.recommended_action + "\n";
  md += citationMarkdown(p.citations || []);
  return md;
}

function appendAskTurn(role, html, metaHtml, abstain) {
  const el = $("ask-thread");
  if (el.querySelector(".d") && !el.querySelector(".ask-bubble")) el.innerHTML = "";
  const wrap = document.createElement("div");
  wrap.innerHTML = renderAskBubble(role, html, metaHtml);
  const node = wrap.firstChild;
  if (abstain && node) node.classList.add("abstain");
  el.appendChild(node);
  el.scrollTop = el.scrollHeight;
}

function renderAssistantPayload(payload, latencyMs) {
  const conf = payload.confidence || "low";
  const retrieval = payload.retrieval || {};
  let meta = '<div class="ask-meta">'
    + '<span class="ask-badge ' + esc(conf) + '">' + esc(conf) + "</span>";
  if (payload.insufficient_context) meta += '<span class="ask-badge low">insufficient context</span>';
  if (latencyMs != null) meta += "<span>" + Math.round(latencyMs) + " ms</span>";
  if (retrieval.documents_considered != null) {
    meta += "<span>" + retrieval.validated_citations + "/" + retrieval.documents_considered + " citations validated</span>";
  }
  meta += "</div>";

  let body = formatAskAnswer(payload.answer || "");
  if (payload.missing_information && payload.missing_information.length) {
    body += "\n\nMissing information:\n" + payload.missing_information.map((m) => "• " + esc(m)).join("\n");
  }
  if (payload.recommended_action) {
    body += "\n\nRecommended action: " + esc(payload.recommended_action);
  }
  if (payload.citations && payload.citations.length) {
    body += '<div class="ask-cites">' + payload.citations.map((c) => {
      const title = esc(c.title || c.document_id || "Source");
      const section = c.section ? " · " + esc(c.section) : "";
      const source = c.source ? " · " + esc(c.source) : "";
      const link = c.url
        ? ' <a href="' + esc(c.url) + '" target="_blank" rel="noopener">' + title + "</a>"
        : title;
      return '<div class="ask-cite">' + link + section + source + "</div>";
    }).join("") + "</div>";
  }
  appendAskTurn("assistant", body, meta, !!payload.insufficient_context);
}

async function loadKnowledgeStatus() {
  try {
    const data = await fetch("/api/dashboard/knowledge/status").then((r) => r.json());
    const status = data.status || "offline";
    const lamp = $("knowledge-lamp");
    if (lamp) lamp.dataset.status = status;
    const label = $("knowledge-lamp-label");
    if (label) {
      label.textContent = status === "ok" ? "Knowledge ready"
        : status === "degraded" ? "Knowledge degraded"
        : "Knowledge offline";
    }
    const tile = $("stat-knowledge");
    if (tile) tile.textContent = status === "ok" ? "ready" : status;
    const sub = $("stat-knowledge-sub");
    if (sub) {
      if (data.live_tools) sub.textContent = "live tools on";
      else sub.textContent = data.qdrant === "reachable" ? "Qdrant up" : (data.detail || "Ask Zyvor");
    }
    const hint = $("ask-hint");
    if (hint) {
      hint.textContent = data.live_tools
        ? "Read-only knowledge + live cluster diagnostics enabled for: "
          + ((data.live_namespaces || []).join(", ") || "configured namespaces")
          + ". Mutations remain out of scope."
        : "Read-only knowledge agent — it will not mutate cluster state. Enable ENABLE_LIVE_CLUSTER_TOOLS for observed-state diagnostics.";
    }
    askStreamingPreferred = data.streaming !== false;
    const remPanel = $("remediation-panel");
    if (remPanel) remPanel.style.display = data.remediation ? "block" : "none";
  } catch (err) {
    const lamp = $("knowledge-lamp");
    if (lamp) lamp.dataset.status = "offline";
  }
}

async function loadAskSuggestions() {
  const chips = $("ask-chips");
  if (!chips) return;
  try {
    const data = await fetch("/api/dashboard/knowledge/suggestions").then((r) => r.json());
    const items = data.suggestions || [];
    chips.innerHTML = items.map((s) =>
      '<button type="button" class="ask-chip" data-q="' + esc(s.question) + '" data-p="' + esc(s.product || "") + '">'
      + esc((s.product ? s.product + ": " : "") + s.question) + "</button>"
    ).join("");
    for (const btn of chips.querySelectorAll(".ask-chip")) {
      btn.addEventListener("click", () => {
        $("ask-question").value = btn.dataset.q || "";
        if (btn.dataset.p) $("ask-product").value = btn.dataset.p;
        focusAskZyvor();
      });
    }
  } catch (err) {
    chips.innerHTML = "";
  }
}

async function submitAsk() {
  if (askBusy) return;
  const question = ($("ask-question").value || "").trim();
  if (question.length < 2) {
    toast("Ask Zyvor", false, "Enter a question");
    return;
  }
  askBusy = true;
  $("ask-submit").disabled = true;
  $("ask-status").textContent = askStreamingPreferred ? "streaming…" : "searching…";
  $("ask-latency").textContent = "";
  appendAskTurn("user", esc(question));
  try {
    localStorage.setItem(ASK_LS_DRAFT, "");
    localStorage.setItem(ASK_LS_PRODUCT, $("ask-product").value || "");
  } catch (e) { /* ignore */ }

  const body = {
    question,
    product: $("ask-product").value || null,
    document_type: $("ask-doctype").value || null,
    thread_id: askThreadId,
  };
  const started = performance.now();
  try {
    if (askStreamingPreferred) {
      await submitAskStream(body, started);
    } else {
      await submitAskJson(body, started);
    }
  } catch (err) {
    appendAskTurn("assistant", esc(String(err)), "", true);
    $("ask-status").textContent = "error";
  } finally {
    askBusy = false;
    $("ask-submit").disabled = false;
  }
}

async function submitAskJson(body, started) {
  const res = await fetch("/api/dashboard/ask", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body),
  });
  const latency = parseFloat(res.headers.get("X-Response-Time-Ms") || "") || (performance.now() - started);
  const payload = await res.json();
  if (!res.ok) {
    appendAskTurn("assistant", esc(payload.detail || "Ask failed"), "", true);
    toast("Ask Zyvor", false, payload.detail || ("HTTP " + res.status));
    $("ask-status").textContent = "failed";
    return;
  }
  finishAskPayload(payload, latency);
}

async function submitAskStream(body, started) {
  const res = await fetch("/api/dashboard/ask/stream", {
    method: "POST",
    headers: { "Content-Type": "application/json", "Accept": "text/event-stream" },
    body: JSON.stringify(body),
  });
  if (!res.ok || !res.body) {
    // Fall back to non-streaming ask.
    await submitAskJson(body, started);
    return;
  }
  const reader = res.body.getReader();
  const decoder = new TextDecoder();
  let buffer = "";
  let gotFinal = false;
  while (true) {
    const { done, value } = await reader.read();
    if (done) break;
    buffer += decoder.decode(value, { stream: true });
    const parts = buffer.split("\n\n");
    buffer = parts.pop() || "";
    for (const part of parts) {
      const line = part.split("\n").find((l) => l.startsWith("data: "));
      if (!line) continue;
      let event;
      try { event = JSON.parse(line.slice(6)); } catch (e) { continue; }
      if (event.event === "understanding") {
        $("ask-status").textContent = "understood · " + (event.data && event.data.intent ? event.data.intent : "routing");
      } else if (event.event === "tool_call") {
        $("ask-status").textContent = "tools · " + (event.tools || []).join(", ");
      } else if (event.event === "tool_result") {
        $("ask-status").textContent = "tool result · " + (event.tool || "ok");
      } else if (event.event === "warning") {
        $("ask-status").textContent = "degraded stream";
      } else if (event.event === "error") {
        appendAskTurn("assistant", esc(event.detail || "stream error"), "", true);
        $("ask-status").textContent = "failed";
        return;
      } else if (event.event === "final") {
        gotFinal = true;
        const payload = { ...(event.data || {}), thread_id: event.thread_id || (event.data && event.data.thread_id) };
        finishAskPayload(payload, performance.now() - started);
      }
    }
  }
  if (!gotFinal) {
    await submitAskJson(body, started);
  }
}

function finishAskPayload(payload, latency) {
  askThreadId = payload.thread_id || askThreadId;
  askLastPayload = payload;
  $("ask-thread-label").textContent = askThreadId ? askThreadId.slice(0, 18) : "new";
  renderAssistantPayload(payload, Number.isFinite(latency) ? latency : null);
  $("ask-question").value = "";
  $("ask-status").textContent = payload.insufficient_context ? "abstained" : "answered";
  if (Number.isFinite(latency)) $("ask-latency").textContent = Math.round(latency) + " ms";
}

async function submitRemediation() {
  const issue = ($("remediation-issue").value || "").trim();
  if (issue.length < 2) { toast("Remediation", false, "Describe the issue"); return; }
  $("remediation-status").textContent = "planning…";
  $("remediation-approve").style.display = "none";
  $("remediation-reject").style.display = "none";
  try {
    const res = await fetch("/api/dashboard/remediation", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ issue, thread_id: remediationThreadId }),
    });
    const data = await res.json();
    $("remediation-out").textContent = JSON.stringify(data, null, 2);
    if (!data.enabled) {
      $("remediation-status").textContent = "disabled";
      return;
    }
    remediationThreadId = data.thread_id || remediationThreadId;
    if (data.interrupted) {
      $("remediation-status").textContent = "awaiting approval";
      $("remediation-approve").style.display = "";
      $("remediation-reject").style.display = "";
    } else {
      $("remediation-status").textContent = "planned";
    }
  } catch (err) {
    $("remediation-status").textContent = "error";
    $("remediation-out").textContent = String(err);
  }
}

async function resumeRemediation(decision) {
  if (!remediationThreadId) { toast("Remediation", false, "No interrupt thread"); return; }
  $("remediation-status").textContent = decision + "…";
  const res = await fetch("/api/dashboard/remediation/resume", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ thread_id: remediationThreadId, decision }),
  });
  const data = await res.json();
  $("remediation-out").textContent = JSON.stringify(data, null, 2);
  $("remediation-approve").style.display = data.interrupted ? "" : "none";
  $("remediation-reject").style.display = data.interrupted ? "" : "none";
  $("remediation-status").textContent = data.interrupted ? "awaiting approval" : (decision + "d");
}

$("remediation-submit")?.addEventListener("click", submitRemediation);
$("remediation-approve")?.addEventListener("click", () => resumeRemediation("approve"));
$("remediation-reject")?.addEventListener("click", () => resumeRemediation("reject"));

function resetAskThread() {
  askThreadId = null;
  askLastPayload = null;
  $("ask-thread").innerHTML = '<span class="d">Ask a question to start a grounded, cited answer.</span>';
  $("ask-thread-label").textContent = "new";
  $("ask-status").textContent = "";
  $("ask-latency").textContent = "";
}

$("ask-submit")?.addEventListener("click", submitAsk);
$("ask-new-thread")?.addEventListener("click", resetAskThread);
$("ask-copy-md")?.addEventListener("click", async () => {
  const md = lastAnswerMarkdown();
  if (!md) { toast("Ask Zyvor", false, "No answer to copy yet"); return; }
  try {
    await navigator.clipboard.writeText(md);
    toast("Ask Zyvor", true, "Copied Markdown for Slack/Jira");
  } catch (err) {
    toast("Ask Zyvor", false, "Clipboard unavailable");
  }
});
$("ask-question")?.addEventListener("keydown", (ev) => {
  if ((ev.metaKey || ev.ctrlKey) && ev.key === "Enter") {
    ev.preventDefault();
    submitAsk();
  }
});
$("ask-question")?.addEventListener("input", () => {
  try { localStorage.setItem(ASK_LS_DRAFT, $("ask-question").value || ""); } catch (e) { /* ignore */ }
});
$("ask-product")?.addEventListener("change", () => {
  try { localStorage.setItem(ASK_LS_PRODUCT, $("ask-product").value || ""); } catch (e) { /* ignore */ }
});
try {
  const draft = localStorage.getItem(ASK_LS_DRAFT);
  const product = localStorage.getItem(ASK_LS_PRODUCT);
  if (draft && $("ask-question")) $("ask-question").value = draft;
  if (product && $("ask-product")) $("ask-product").value = product;
} catch (e) { /* ignore */ }
loadAskSuggestions();
loadKnowledgeStatus();

/* sound cue on finish — rising tone on green, falling on red (mutable) */
function beep(ok) {
  if (!soundOn) return;
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const o = ctx.createOscillator(), g = ctx.createGain();
    o.connect(g); g.connect(ctx.destination);
    o.type = "sine";
    const t = ctx.currentTime;
    o.frequency.setValueAtTime(ok ? 520 : 400, t);
    o.frequency.exponentialRampToValueAtTime(ok ? 780 : 240, t + 0.18);
    g.gain.setValueAtTime(0.14, t);
    g.gain.exponentialRampToValueAtTime(0.001, t + 0.35);
    o.start(t); o.stop(t + 0.36);
  } catch (e) { /* audio unavailable */ }
}

/* confetti on an all-green finish */
function confettiBurst() {
  const canvas = $("confetti"), ctx = canvas.getContext("2d");
  canvas.width = innerWidth; canvas.height = innerHeight; canvas.style.display = "block";
  const colors = ["#22c55e", "#007aff", "#a78bfa", "#f59e0b", "#f0583a"];
  const parts = Array.from({ length: 140 }, () => ({
    x: innerWidth / 2 + (Math.random() - 0.5) * 200, y: innerHeight / 3,
    vx: (Math.random() - 0.5) * 14, vy: Math.random() * -12 - 4,
    c: colors[Math.floor(Math.random() * colors.length)], r: 3 + Math.random() * 4, life: 0,
  }));
  let frame = 0;
  (function anim() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    for (const p of parts) {
      p.vy += 0.35; p.x += p.vx; p.y += p.vy; p.life++;
      ctx.fillStyle = p.c; ctx.globalAlpha = Math.max(0, 1 - p.life / 90);
      ctx.fillRect(p.x, p.y, p.r, p.r);
    }
    if (++frame < 90) requestAnimationFrame(anim);
    else { ctx.clearRect(0, 0, canvas.width, canvas.height); canvas.style.display = "none"; }
  })();
}

document.addEventListener("keydown", (ev) => {
  if ((ev.metaKey || ev.ctrlKey) && ev.key.toLowerCase() === "k") { ev.preventDefault(); openPalette(); return; }
  if (ev.key === "Escape") { closeDrawer(); closePalette(); }
  if (ev.key === "r" && !ev.metaKey && !ev.ctrlKey && !/INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName)) sync();
});
$("logout").addEventListener("click", async (ev) => {
  ev.preventDefault();
  await fetch("/api/logout", { method: "POST" });
  location.href = "/login";
});

/* job triggers — every CLI capability, online */
function jobParams(kind) {
  if (kind === "smoke") return {
    grep: ($("sm-grep") && $("sm-grep").value.trim()) || "",
    shard: ($("sm-shard") && $("sm-shard").value.trim()) || "",
  };
  if (kind === "full") return {
    source: $("run-source").value,
    spec: $("run-spec").value.trim(),
    pr_number: $("run-pr").value ? parseInt($("run-pr").value, 10) : null,
    expand_coverage: $("run-coverage").checked,
  };
  if (kind === "generate") return {
    source: $("gen-source").value,
    spec: $("gen-spec").value.trim(),
    expand_coverage: $("gen-coverage").checked,
  };
  if (kind === "discover") return { source: $("disc-source").value };
  if (kind === "create") return { description: $("nl-desc").value.trim(), execute: $("nl-execute").checked };
  if (kind === "regression") return { update_baselines: $("reg-update").checked };
  if (kind === "crawl_test") return {
    url: $("ct-url").value.trim(),
    username: $("ct-user").value.trim(),
    password: $("ct-pass").value,
    insecure: $("ct-insecure").checked,
    max_pages: parseInt($("ct-pages").value, 10) || 30,
  };
  if (kind === "audit") return {
    url: $("au-url").value.trim(),
    max_pages: parseInt($("au-pages").value, 10) || 10,
    insecure: $("au-insecure").checked,
    checks: Array.from(document.querySelectorAll("#au-checks input:checked")).map((c) => c.value),
  };
  if (kind === "flaky") return { runs: parseInt($("fl-runs").value, 10) || 3, target: "manual" };
  if (kind === "screenshot") return {
    url: $("sh-url").value.trim(),
    viewports: Array.from(document.querySelectorAll("#sh-vps input:checked")).map((c) => c.value).filter((v) => v !== "on"),
    full_page: $("sh-full").checked,
  };
  if (kind === "compare") return { url_a: $("cmp-a").value.trim(), url_b: $("cmp-b").value.trim(), insecure: $("cmp-insecure").checked };
  if (kind === "ping") return { urls: $("pg-urls").value };
  if (kind === "loadtest") return { url: $("lt-url").value.trim(), requests: parseInt($("lt-n").value, 10) || 100, concurrency: parseInt($("lt-c").value, 10) || 10 };
  if (kind === "tls") return { host: $("tls-host").value.trim() };
  if (kind === "flow") return {
    url: $("fw-url").value.trim(),
    description: $("fw-desc").value,
    username: $("fw-user").value.trim(),
    password: $("fw-pass").value,
    session: $("fw-session").value.trim(),
    browser: $("fw-browser").value,
    device: $("fw-device").value,
    throttle: $("fw-throttle").value,
    insecure: $("fw-insecure").checked,
    record: $("fw-record").checked,
  };
  if (kind === "ai_flow") return {
    url: $("ai-url").value.trim(),
    goal: $("ai-goal").value.trim(),
    session: $("ai-session").value.trim(),
    max_steps: parseInt($("ai-steps").value, 10) || 20,
    insecure: $("ai-insecure").checked,
  };
  if (kind === "route_sweep") return {
    url: $("rs-url").value.trim(),
    routes: $("rs-routes").value,
    viewports: Array.from(document.querySelectorAll("#rs-vps input[value]:checked")).map((c) => c.value),
    update_baselines: $("rs-update").checked,
    insecure: $("rs-insecure").checked,
    auto: $("rs-auto").checked,
  };
  if (kind === "api_contract") {
    // combine host + port (port defaults to Forge's 24631); default scheme http for a bare host
    let host = $("api-url").value.trim();
    const port = $("api-port").value.trim();
    if (host && !/^https?:\/\//.test(host)) host = "http://" + host;
    if (host && port) { try { const u = new URL(host); if (!u.port) { u.port = port; host = u.origin; } } catch (e) { /* leave as typed */ } }
    let spec = $("api-spec").value.trim();
    const inline = $("api-spec-json").value.trim();
    if (inline) { try { spec = JSON.parse(inline); } catch (e) { toast("api", false, "inline spec is not valid JSON"); throw e; } }
    else if (spec && spec.startsWith("/") && host) spec = host + spec;  // relative spec → absolute
    const tok = $("api-token").value.trim();
    return {
      url: host,
      mode: "spec",
      spec,
      auth: tok ? { token: tok } : null,
      include_writes: $("api-writes").checked,
      insecure: $("api-insecure").checked,
    };
  }
  if (kind === "vitals") return {
    url: $("cwv-url").value.trim(),
    device: $("cwv-device").value,
    throttle: $("cwv-throttle").value,
    insecure: $("cwv-insecure").checked,
  };
  if (kind === "realtime") return {
    url: $("rt-url").value.trim(),
    ws: $("rt-ws").value.trim(),
    sse: $("rt-sse").value.trim(),
    ticket_url: $("rt-ticket").value.trim(),
    token: $("rt-token").value.trim(),
    subprotocol_jwt: $("rt-subproto").checked,
    expect_messages: parseInt($("rt-expect").value, 10) || 1,
    live_selector: $("rt-live").value.trim(),
    insecure: $("rt-insecure").checked,
  };
  if (kind === "auth_test") return {
    url: $("au-url").value.trim(),
    protected: $("au-protected").value.trim() || "/",
    login_url: $("au-login").value.trim(),
    api_login: $("au-api").value.trim(),
    logout_url: $("au-logout").value.trim(),
    username: $("au-user").value.trim(),
    password: $("au-pass").value,
    save_session: $("au-save").checked,
    insecure: $("au-insecure").checked,
  };
  if (kind === "har_replay") return {
    url: $("har-url").value.trim(),
    mode: $("har-mode").value,
    har: $("har-path").value.trim(),
    routes: $("har-routes").value,
    expect_text: $("har-expect").value.trim(),
    not_found_ok: $("har-fallback").checked,
    insecure: $("har-insecure").checked,
  };
  if (kind === "import_codegen") return {
    script: $("cg-script").value,
    url: $("cg-url").value.trim(),
    run: $("cg-run").checked,
    insecure: $("cg-insecure").checked,
  };
  if (kind === "misconfig_scan") return {
    url: $("ms-url").value.trim(),
    max_paths: parseInt($("ms-paths").value, 10) || 60,
    insecure: $("ms-insecure").checked,
    engagement_id: $("ms-eng").value,
  };
  if (kind === "cve_lookup") return {
    url: $("cve-url").value.trim(),
    insecure: $("cve-insecure").checked,
    engagement_id: $("cve-eng").value,
  };
  if (kind === "llm_redteam") return {
    target: $("lr-target").value,
    base_url: $("lr-baseurl").value.trim(),
    api_key: $("lr-apikey").value,
    categories: Array.from(document.querySelectorAll("#lr-categories input:checked")).map((c) => c.value),
    engagement_id: $("lr-eng").value,
  };
  if (kind === "exploit_poc") return {
    url: $("ep-url").value.trim(),
    finding_description: $("ep-finding").value.trim(),
    timeout_s: parseInt($("ep-timeout").value, 10) || 60,
    engagement_id: $("ep-eng").value,
  };
  if (kind === "attack_chain") return {
    url: $("ac-url").value.trim(),
    objective: $("ac-objective").value.trim(),
    max_steps: parseInt($("ac-steps").value, 10) || 5,
    timeout_s: parseInt($("ac-timeout").value, 10) || 60,
    engagement_id: $("ac-eng").value,
  };
  if (kind === "host_pentest") {
    const envVar = $("hp-secretenv").value.trim();
    const creds = { username: $("hp-user").value.trim() };
    creds[$("hp-authmethod").value] = { "$secret": "env:" + envVar };
    return {
      host: $("hp-host").value.trim(),
      port: parseInt($("hp-port").value, 10) || 22,
      finding_description: $("hp-finding").value.trim(),
      creds,
      timeout_s: parseInt($("hp-timeout").value, 10) || 60,
      engagement_id: $("hp-eng").value,
    };
  }
  if (kind === "cloud_pentest") {
    let creds = {};
    const raw = $("cp-creds").value.trim();
    if (raw) {
      try { creds = JSON.parse(raw); }
      catch (e) { toast("cloud_pentest", false, "creds is not valid JSON"); throw e; }
    }
    return {
      provider: $("cp-provider").value,
      target: $("cp-target").value.trim(),
      finding_description: $("cp-finding").value.trim(),
      creds,
      timeout_s: parseInt($("cp-timeout").value, 10) || 60,
      engagement_id: $("cp-eng").value,
    };
  }
  const PROBES = ["redirects","headers","cookies","robots","security_paths","api_check","sitemap_test","dns_records","cors","transport"];
  if (PROBES.includes(kind)) {
    const t = $("pr-target").value.trim();
    return kind === "dns_records" ? { host: t } : { url: t };
  }
  return {};
}

async function startJob(kind) {
  const el = $("run-status");
  el.classList.remove("err");
  if (kind === "regression" && $("reg-update").checked
      && !confirm("Update baselines? Current screenshots become the new reference.")) return;
  try {
    const res = await fetch("/api/dashboard/jobs", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ kind, params: jobParams(kind) }),
    });
    if (res.status === 409) { el.textContent = "a job is already in progress"; return; }
    if (res.status === 400 || res.status === 422) {
      const data = await res.json();
      el.classList.add("err");
      el.textContent = String(data.detail || "invalid request").slice(0, 90);
      return;
    }
    $("job-result").style.display = "none";
    await sync();
    $("job-live").scrollIntoView({ behavior: "smooth", block: "center" });
  } catch (err) {
    el.classList.add("err");
    el.textContent = "trigger failed: " + err;
  }
}
$("btn-stop").addEventListener("click", async () => {
  if (!confirm("Stop the running job?")) return;
  await fetch("/api/dashboard/jobs/cancel", { method: "POST" });
  toast("job", false, "cancellation requested");
  sync();
});
$("btn-copylog").addEventListener("click", () => {
  navigator.clipboard.writeText(window._lastLog || "").then(() => toast("copied", true, "log copied to clipboard"));
});
$("btn-dllog").addEventListener("click", () => {
  const blob = new Blob([window._lastLog || ""], { type: "text/plain" });
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "argus-job.log";
  a.click();
  URL.revokeObjectURL(a.href);
});
for (const btn of document.querySelectorAll(".act-btn")) {
  btn.addEventListener("click", () => startJob(btn.dataset.kind));
}

const KIND_LABELS = { smoke: "smoke tests", full: "full pipeline", generate: "generate", discover: "discover", create: "NL create", regression: "regression", crawl_test: "crawl & test", audit: "site audit", flaky: "flaky check", screenshot: "screenshot", compare: "compare", ping: "uptime ping", loadtest: "load test", tls: "TLS check",
  redirects: "redirect chain", headers: "HTTP headers", cookies: "cookie audit", robots: "robots/sitemap",
  security_paths: "exposed paths", api_check: "API check", sitemap_test: "sitemap URLs", dns_records: "DNS records",
  cors: "CORS check", transport: "compression", flow: "flow test", route_sweep: "route sweep",
  api_contract: "API contract", auth_test: "auth & session", realtime: "live data", vitals: "web vitals", ai_flow: "AI test",
  har_replay: "HAR record/replay", import_codegen: "import codegen",
  misconfig_scan: "misconfig scan", cve_lookup: "CVE lookup", llm_redteam: "LLM red-team",
  exploit_poc: "exploit PoC", attack_chain: "attack chain", host_pentest: "host pentest", cloud_pentest: "cloud pentest" };

let lastToastKey = "";
function renderRunStatus(st) {
  const el = $("run-status");
  const busy = !!(st && st.running);
  for (const btn of document.querySelectorAll(".act-btn")) btn.disabled = busy;

  // live job panel: kind, elapsed, live pass/fail tally, per-test rows, streaming log
  const live = $("job-live");
  if (busy) {
    const secs = st.started_at ? Math.max(0, (Date.now() - new Date(st.started_at).getTime()) / 1000 | 0) : 0;
    live.style.display = "block";
    $("live-kind").textContent = KIND_LABELS[st.kind] || st.kind;
    $("live-elapsed").textContent = "· " + rel(secs) + " elapsed";
    const t = st.live_tally || { passed: 0, failed: 0 };
    $("live-tally").innerHTML = (t.passed || t.failed)
      ? '· <span class="pass">' + t.passed + " ✓</span> "
        + (t.failed ? '<span class="fail">' + t.failed + " ✗</span>" : "")
      : "";
    const lc = st.live_cases || [];
    $("live-cases").innerHTML = lc.slice(-40).map((c) =>
      '<span class="livecase ' + (c.status === "passed" ? "pass" : "fail") + '"><span class="dot"></span>'
      + esc((c.status === "passed" ? "" : "✗ ") + c.title) + "</span>").join("");
    const log = $("live-log");
    const atBottom = log.scrollHeight - log.scrollTop - log.clientHeight < 40;
    log.textContent = (st.progress || []).join("\n") || "starting…";
    if (atBottom) log.scrollTop = log.scrollHeight;
    window._lastLog = (st.progress || []).join("\n");
  } else {
    live.style.display = "none";
  }

  if (busy) {
    el.classList.remove("err");
    el.textContent = "";
  } else if (st && st.error) {
    el.classList.add("err");
    el.textContent = (KIND_LABELS[st.kind] || "job") + " failed: " + st.error.slice(0, 90);
  } else {
    el.classList.remove("err");
    el.textContent = "";
  }

  // toast once per completed job (skip page-load backfill)
  if (st && !st.running && st.finished_at) {
    const key = st.finished_at + (st.kind || "");
    if (lastToastKey && key !== lastToastKey) {
      const r = st.result || {};
      toast(KIND_LABELS[st.kind] || st.kind, !st.error,
        st.error ? st.error.slice(0, 80)
        : (r.total != null ? r.passed + "/" + r.total + " passed" : "completed"));
      // celebrate a clean, non-empty test result
      const clean = !st.error && r.total > 0 && r.failed === 0;
      if (clean && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) confettiBurst();
      beep(clean && !st.error);
    }
    lastToastKey = key;
  } else if (st && !st.finished_at && !lastToastKey) {
    lastToastKey = "init";
  }

  renderFeed(st && st.recent);
  renderJobResult(st);
  ensureBusyPoll(busy);
  try {
    if (busy) window.__signalSet?.({ busy: true, mood: "busy" });
    else window.__signalSet?.({ busy: false });
    if (!busy && st && !st.error && st.result && st.result.total > 0 && st.result.failed === 0)
      window.__unlockAchieve?.("clean", "Flawless run", (KIND_LABELS[st.kind] || st.kind) + " finished with zero failures.");
  } catch (e) {}
}

function renderFeed(items) {
  if (!items) return;
  const el = $("feed");
  if (!items.length) {
    el.innerHTML = '<span class="d">No activity yet this session.</span>';
    return;
  }
  el.innerHTML = items.map((it) => {
    if (it.type === "webhook") {
      return '<div class="feed-item"><span class="f-when">' + relIso(it.at) + '</span>'
        + '<span class="f-kind">🪝 ' + esc(it.event) + '</span>'
        + '<span class="f-brief">' + esc((it.repo || "") + (it.detail ? " · " + it.detail : "")) + "</span></div>";
    }
    return '<div class="feed-item"><span class="f-when">' + relIso(it.at) + '</span>'
      + '<span class="f-kind">' + (it.ok ? "✅" : "❌") + " " + esc(KIND_LABELS[it.kind] || it.kind) + '</span>'
      + '<span class="f-brief">' + esc(it.brief) + " · " + rel(it.duration_s | 0) + "</span></div>";
  }).join("");
}

let lastResultKey = "";
function renderJobResult(st) {
  const panel = $("job-result");
  if (!st || st.running || (!st.result && !st.error)) return;
  const key = (st.finished_at || "") + (st.kind || "");
  if (key === lastResultKey && panel.style.display !== "none") return;
  lastResultKey = key;
  const r = st.result || {};
  let dur = "";
  if (st.started_at && st.finished_at) {
    dur = ' <span class="d" style="font-weight:400">· took ' + rel(Math.max(0, (new Date(st.finished_at) - new Date(st.started_at)) / 1000 | 0)) + "</span>";
  }
  let html = '<div class="result-title">' + esc(KIND_LABELS[st.kind] || st.kind) + " result" + dur + "</div>";

  const caseTable = (cases) => {
    if (!cases || !cases.length) return "";
    const fails = cases.filter((c) => c.status !== "passed");
    let out = "";
    if (fails.length) {
      out += '<div class="err-summary"><div class="k">⚠ ' + fails.length + " failure(s)</div>"
        + fails.map((c) => '<div style="margin-bottom:8px"><b>' + esc(c.title) + "</b> "
          + '<button class="copy-btn" data-copy="' + encodeURIComponent(c.error || "") + '">⧉ copy</button>'
          + (c.hint ? '<div style="color:var(--accent-2);font-size:0.875rem;margin:2px 0">💡 ' + esc(c.hint) + "</div>" : "")
          + '<div class="case-err">' + esc((c.error || "").slice(0, 600))
          + (c.console_logs && c.console_logs.length ? "\nconsole: " + esc(c.console_logs.join("\n")) : "")
          + (c.network_errors && c.network_errors.length ? "\nnetwork: " + esc(c.network_errors.join("\n")) : "")
          + "</div></div>").join("") + "</div>";
    }
    out += '<div style="margin:6px 0"><label class="chk"><input type="checkbox" id="fails-only"> failures only</label></div>';
    out += '<table class="runs-table" id="case-table"><tbody>'
      + cases.map((c) => '<tr class="case-row ' + (c.status === "passed" ? "" : "is-fail") + '">'
        + '<td><span class="chip ' + (c.status === "passed" ? "pass" : "fail") + '">'
        + (c.status === "passed" ? "PASS" : esc((c.status || "fail").toUpperCase())) + "</span></td>"
        + "<td>" + esc(c.title) + (c.browser ? ' <span class="d">' + esc(c.browser) + "</span>" : "") + "</td>"
        + '<td class="d">' + (c.duration_ms != null ? c.duration_ms + "ms" : "") + "</td>"
        + "<td>" + (c.video ? '<a class="rlink" href="' + esc(c.video) + '" target="_blank">🎬</a> ' : "")
        + (c.trace ? '<a class="rlink" href="' + esc(c.trace) + '" target="_blank">🔍</a>' : "") + "</td>"
        + '<td style="max-width:420px;color:var(--status-error);font-size:0.875rem">' + esc((c.error || "").slice(0, 200)) + "</td></tr>").join("")
      + "</tbody></table>";
    return out;
  };

  const downloadRow = (rep) => {
    if (!rep || (!rep.csv && !rep.html && !rep.md && !rep.pdf)) return "";
    return '<div class="dl-row">Download: '
      + (rep.html ? '<a class="dl-btn" href="' + esc(rep.html) + '" target="_blank" title="Open the full formatted report">⬇ HTML</a>' : "")
      + (rep.pdf ? '<a class="dl-btn" href="/api/dashboard/jobs/report.pdf" title="Print-ready PDF for sharing">⬇ PDF</a>' : "")
      + (rep.md ? '<a class="dl-btn" href="/api/dashboard/jobs/report.md" title="Markdown — pastes cleanly into a GitHub issue, PR, or Slack message">⬇ Markdown</a>'
        + '<button class="dl-btn" id="btn-copy-md" title="Copy the Markdown report straight to your clipboard">⧉ Copy MD</button>' : "")
      + (rep.csv ? '<a class="dl-btn" href="/api/dashboard/jobs/report.csv" title="Raw rows for a spreadsheet">⬇ CSV</a>' : "")
      + '<button class="dl-btn" id="btn-rerun">⟳ Rerun</button></div>';
  };

  // generic probe result: {summary, status, columns, rows, issues}
  if (!st.error && r.columns && r.rows) {
    const sc = r.status === "ok" ? "pass" : r.status === "warn" ? "" : "fail";
    html += '<div class="d"><span class="chip ' + sc + '" style="' + (r.status === "warn" ? "color:var(--status-warn)" : "") + '">'
      + esc((r.status || "").toUpperCase()) + "</span> " + esc(r.summary || "") + "</div>";
    if (r.issues && r.issues.length) {
      html += '<div class="err-summary" style="margin:8px 0">' + r.issues.map((i) => '<div class="case-err">' + esc(i) + "</div>").join("") + "</div>";
    }
    html += '<div style="overflow-x:auto"><table class="runs-table" style="margin-top:6px"><tbody>'
      + "<tr>" + r.columns.map((c) => "<th style=\"text-align:left;color:var(--text-muted);font-size:11px\">" + esc(c) + "</th>").join("") + "</tr>"
      + r.rows.map((row) => "<tr>" + row.map((cell, ci) => "<td" + (ci === 0 ? ' class="d"' : "") + ">" + esc(String(cell)) + "</td>").join("") + "</tr>").join("")
      + "</tbody></table></div>";
    panel.innerHTML = html;
    panel.style.display = "block";
    return;
  }

  if (st.error) {
    html += '<div class="result-err">' + esc(st.error) + "</div>";
    if (st.progress && st.progress.length) {
      html += '<pre style="margin:10px 0 0;font-family:var(--font-mono);font-size:0.8rem;color:var(--text-muted);white-space:pre-wrap">'
        + esc(st.progress.slice(-8).join("\n")) + "</pre>";
    }
  } else if (st.kind === "discover") {
    html += '<div class="d">' + r.inventory + " candidates · " + r.gaps_total + " gaps · " + r.files_scanned + " files scanned</div>";
    if (r.gaps && r.gaps.length) {
      html += '<table class="runs-table" style="margin-top:8px"><tbody>'
        + r.gaps.map((g) => "<tr><td>" + esc(g.kind) + "</td><td>" + esc(g.path) + "</td><td>" + esc(g.title) + "</td><td>" + esc(g.priority) + "</td></tr>").join("")
        + "</tbody></table>";
    }
  } else if (st.kind === "generate" || st.kind === "create") {
    const files = r.generated || [];
    html += '<div class="d">' + files.length + " test file(s) generated"
      + (r.requirements != null ? " from " + r.requirements + " requirement(s)" : "")
      + (r.total != null ? " · executed: " + r.passed + "/" + r.total + " passed" : "") + "</div>";
    html += '<div class="result-files" style="margin-top:6px">' + files.map(esc).join("<br>") + "</div>";
  } else if (st.kind === "ai_flow") {
    html += '<div class="d"><b class="' + (r.success ? "pass" : "fail") + '">' + (r.success ? "✅ goal achieved" : "⚠ stopped") + "</b> · "
      + esc(r.goal) + ' <span class="d">· ' + esc(r.mode || "") + " agent</span></div>";
    if (r.summary) html += '<div class="d" style="margin:4px 0">' + esc(r.summary) + "</div>";
    if (r.video) html += '<video controls src="' + esc(r.video) + '" style="max-width:min(920px,100%);width:100%;border:1px solid var(--separator);border-radius:12px;margin:10px 0"></video>';
    if (r.trace) html += '<div class="dl-row" style="margin:2px 0 8px">🔍 <a class="rlink" href="' + esc(r.trace) + '" target="_blank">download trace.zip</a></div>';
    html += '<table class="runs-table" style="margin-top:6px"><tbody>'
      + (r.ai_steps || []).map((s) => "<tr><td>" + s.n + "</td>"
        + '<td><span class="chip ' + (s.status === "passed" ? "pass" : "fail") + '">' + (s.status === "passed" ? "OK" : "FAIL") + "</span></td>"
        + "<td>" + esc(s.desc || s.action) + "</td>"
        + "<td>" + (s.shot ? '<a class="rlink" href="' + esc(s.shot) + '" target="_blank">shot</a>' : "")
        + '</td><td class="d" style="color:var(--status-error);max-width:300px">' + esc(s.error || "") + "</td></tr>").join("")
      + "</tbody></table>";
  } else if (st.kind === "flow") {
    html += '<div class="d"><b class="' + (r.failed ? "fail" : "pass") + '">' + r.passed + "/" + r.total + " steps passed</b> · "
      + esc(r.url) + " · parsed by " + esc(r.mode)
      + (r.browser && r.browser !== "chromium" ? " · " + esc(r.browser) : "")
      + (r.device && r.device !== "desktop" ? " · " + esc(r.device) : "")
      + (r.throttle && r.throttle !== "none" ? " · " + esc(r.throttle) : "") + "</div>";
    if (r.video) html += '<video controls src="' + esc(r.video) + '" style="max-width:min(920px,100%);width:100%;border:1px solid var(--separator);border-radius:12px;margin:10px 0"></video>';
    if (r.trace) html += '<div class="dl-row" style="margin:2px 0 8px">🔍 <a class="rlink" href="' + esc(r.trace) + '" target="_blank">download trace.zip</a> <span class="d">— open at trace.playwright.dev for step-by-step DOM/network/console</span></div>';
    html += '<table class="runs-table" style="margin-top:6px"><tbody>'
      + (r.flow_steps || []).map((s) => "<tr><td>" + s.n + "</td>"
        + '<td><span class="chip ' + (s.status === "passed" ? "pass" : "fail") + '">' + (s.status === "passed" ? "PASS" : "FAIL") + "</span></td>"
        + "<td>" + esc(s.desc) + "</td>"
        + "<td>" + (s.shot ? '<a class="rlink" href="' + esc(s.shot) + '" target="_blank">shot</a>' : "") + "</td>"
        + '<td style="color:var(--status-error);font-size:0.875rem;max-width:480px">' + esc(s.error || "")
        + (s.hint ? '<div style="color:var(--accent-2)">💡 ' + esc(s.hint) + "</div>" : "") + "</td></tr>").join("")
      + "</tbody></table>";
  } else if (st.kind === "route_sweep") {
    html += '<div class="d">' + r.routes + " route(s) × " + (r.viewports || []).join("/") + " · "
      + (r.baselines_updated ? '<span class="pass">' + r.new_baselines + " baseline(s) captured</span>"
         : '<span class="' + (r.fail_count ? "fail" : "pass") + '">' + r.fail_count + " changed</span>") + "</div>";
    html += '<div style="overflow-x:auto"><table class="runs-table" style="margin-top:6px"><tbody>'
      + "<tr><th>route</th><th>viewport</th><th>status</th><th>diff</th><th></th></tr>"
      + (r.sweep_rows || []).map((x) => "<tr><td>" + esc(x.route) + "</td><td class=\"d\">" + esc(x.viewport) + "</td>"
        + '<td style="color:' + (x.status === "fail" ? "var(--status-error)" : x.status === "baseline" ? "var(--status-warn)" : "var(--status-ok)") + '">' + esc(x.status) + "</td>"
        + "<td>" + (x.diff || 0) + "%</td>"
        + '<td><a class="rlink" href="' + esc(x.cur) + '" target="_blank">view</a></td></tr>').join("")
      + "</tbody></table></div>";
  } else if (st.kind === "api_contract") {
    html += '<div class="d"><b class="' + (r.failed ? "fail" : "pass") + '">' + r.passed + "/" + r.total
      + " checks passed</b> · " + esc(r.url) + " · " + esc(r.mode) + " mode</div>";
    const rows = r.mode === "spec" ? (r.endpoints || []) : (r.steps || []);
    html += '<div style="overflow-x:auto"><table class="runs-table" style="margin-top:6px"><tbody>'
      + (r.mode === "spec" ? "<tr><th>method</th><th>path</th><th>status</th><th>result</th><th>schema / note</th><th>ms</th></tr>"
                           : "<tr><th>#</th><th>step</th><th>status</th><th>result</th><th>error</th><th>ms</th></tr>")
      + rows.map((x) => "<tr>"
        + (r.mode === "spec"
            ? "<td><b>" + esc(x.method) + "</b></td><td><code>" + esc(x.path) + "</code></td><td>" + x.status + "</td>"
              + '<td><span class="chip ' + (x.ok ? "pass" : "fail") + '">' + (x.ok ? "OK" : "FAIL") + "</span></td>"
              + '<td style="color:var(--status-error);font-size:0.875rem;max-width:480px">' + esc((x.schema_errors || []).join("; ") || x.note || "") + "</td>"
            : "<td>" + x.n + "</td><td>" + esc(x.desc) + "</td><td>" + x.status + "</td>"
              + '<td><span class="chip ' + (x.ok ? "pass" : "fail") + '">' + (x.ok ? "OK" : "FAIL") + "</span></td>"
              + '<td style="color:var(--status-error);font-size:0.875rem;max-width:480px">' + esc(x.error || "") + "</td>")
        + "<td>" + (x.latency_ms || 0) + "</td></tr>").join("")
      + "</tbody></table></div>";
  } else if (st.kind === "vitals") {
    const gc = (g) => g === "good" ? "var(--status-ok)" : g === "poor" ? "var(--status-error)" : "var(--status-warn)";
    html += '<div class="d">overall <b style="color:' + gc(r.overall) + '">' + esc((r.overall || "").toUpperCase()) + "</b> · "
      + esc(r.url) + " · " + esc(r.device || "desktop") + (r.throttle && r.throttle !== "none" ? " · " + esc(r.throttle) : "") + "</div>";
    html += '<div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px">'
      + Object.entries(r.metrics || {}).map(([k, m]) =>
          '<div class="stat-tile" style="padding:8px 12px"><span class="stat-label">' + k + '</span>'
          + '<span class="stat-value" style="font-size:1rem;color:' + gc(m.grade) + '">'
          + (m.value == null ? "—" : m.value + (k === "CLS" ? "" : "ms")) + "</span></div>").join("") + "</div>";
    if (r.shot_url) html += '<img src="' + esc(r.shot_url) + '" style="max-width:min(920px,100%);width:100%;border:1px solid var(--separator);border-radius:12px;margin-top:10px">';
  } else if (st.kind === "realtime") {
    html += '<div class="d"><b class="' + (r.failed ? "fail" : "pass") + '">' + r.passed + "/" + r.total + " checks passed</b> · " + esc(r.url)
      + (r.live ? " · page <b style=\"color:" + (r.live.classification === "ok" ? "var(--status-ok)" : "var(--status-error)") + '">' + esc(r.live.classification) + "</b>" : "") + "</div>";
    html += '<table class="runs-table" style="margin-top:6px"><tbody>'
      + (r.checks || []).map((c) => "<tr>"
        + '<td><span class="chip ' + (c.ok ? "pass" : "fail") + '">' + (c.ok ? "OK" : "FAIL") + "</span></td>"
        + "<td>" + esc(c.name) + '</td><td class="d">' + esc(c.detail || "") + "</td></tr>").join("")
      + "</tbody></table>";
