<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zyvor Mission Control</title>
<style>
  /* Zyvor Argus — Mission Control (elevated console UX) */
  :root {
    color-scheme: dark;
    --radius-liquid: 16px;
    --blur-liquid: 18px;
    --bg: #070a10;
    --accent: #3b82f6;
    --accent-2: #38bdf8;
    --accent-hot: #a78bfa;
    --surface-base: rgba(18, 24, 36, 0.82);
    --surface-elevated: rgba(28, 36, 50, 0.92);
    --surface-strong: #1a2332;
    --surface-muted: rgba(148, 168, 200, 0.06);
    --separator: rgba(148, 168, 200, 0.16);
    --fill-secondary: rgba(148, 168, 200, 0.1);
    --glass-border-strong: rgba(148, 168, 200, 0.32);
    --glass-shadow: 0 24px 48px -28px rgba(0, 0, 0, 0.75), inset 0 1px 0 rgba(255,255,255,0.04);
    --text-primary: #f4f7fc;
    --text-secondary: #c5cfdf;
    --text-muted: #8e9bb0;
    --status-ok: #22c55e;
    --status-warn: #f5a623;
    --status-error: #ef4444;
    --status-info: #3b82f6;
    --status-neutral: #8e9bb0;
    --font-base: "SF Pro Text", "Segoe UI", system-ui, -apple-system, sans-serif;
    --font-mono: ui-monospace, "SF Mono", SFMono-Regular, "JetBrains Mono", "Cascadia Code", Menlo, monospace;
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  html, body { min-height: 100%; }
  body {
    margin: 0; background: var(--bg); color: var(--text-primary);
    font-family: var(--font-base); font-size: 16px; line-height: 1.55; letter-spacing: -0.011em;
    -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; text-rendering: optimizeLegibility;
  }
  body::before {
    content: ""; position: fixed; inset: 0; pointer-events: none; z-index: 0;
    background:
      radial-gradient(ellipse 55% 45% at 8% -8%, rgba(59,130,246,0.22), transparent 58%),
      radial-gradient(ellipse 45% 40% at 92% 0%, rgba(56,189,248,0.12), transparent 55%),
      radial-gradient(ellipse 50% 50% at 70% 100%, rgba(167,139,250,0.08), transparent 60%),
      linear-gradient(180deg, #0b1220 0%, var(--bg) 28%, var(--bg) 100%);
  }
  body::after {
    content: ""; position: fixed; inset: 0; pointer-events: none; z-index: 0; opacity: 0.035;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 180px 180px;
  }
  main { width: 100%; max-width: none; margin: 0; padding: 14px clamp(14px, 2vw, 32px) 72px; position: relative; z-index: 1; }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes shimmer { 0% { transform: translateX(-120%) skewX(-12deg); } 100% { transform: translateX(220%) skewX(-12deg); } }
  @keyframes pulse { 50% { opacity: 0.35; } }
  @keyframes soft-glow {
    0%, 100% { box-shadow: 0 24px 48px -28px rgba(0,0,0,0.75), 0 0 0 0 rgba(59,130,246,0); }
    50% { box-shadow: 0 24px 48px -28px rgba(0,0,0,0.75), 0 0 32px -6px rgba(59,130,246,0.35); }
  }
  @keyframes toast-in { from { opacity: 0; transform: translateX(24px); } to { opacity: 1; transform: none; } }

  .topbar {
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-bottom: 14px; padding: 10px 14px;
    border-radius: 999px; border: 1px solid var(--separator); background: rgba(12, 18, 28, 0.72);
    backdrop-filter: blur(var(--blur-liquid)) saturate(1.2); -webkit-backdrop-filter: blur(var(--blur-liquid)) saturate(1.2);
    box-shadow: var(--glass-shadow); animation: rise 0.45s var(--ease-out) both; position: sticky; top: 10px; z-index: 8;
  }
  .topbar-brand {
    display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 0.78rem;
    letter-spacing: 0.14em; font-weight: 700; color: var(--text-secondary); text-transform: uppercase;
  }
  .topbar-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 12px var(--accent); }
  .topbar-spacer { flex: 1; min-width: 8px; }
  .topbar-hint { display: inline-flex; align-items: center; gap: 8px; color: var(--text-muted); font-size: 0.85rem; }
  .topbar .run-btn { padding: 6px 14px; }
  .knowledge-lamp {
    display: inline-flex; align-items: center; gap: 8px; font-size: 0.82rem; color: var(--text-muted);
    padding: 4px 10px; border-radius: 999px; border: 1px solid var(--separator); background: var(--surface-muted);
  }
  .knowledge-lamp .kl-dot {
    width: 8px; height: 8px; border-radius: 50%; background: var(--status-neutral);
  }
  .knowledge-lamp[data-status="ok"] .kl-dot { background: var(--status-ok); box-shadow: 0 0 10px var(--status-ok); }
  .knowledge-lamp[data-status="degraded"] .kl-dot { background: var(--status-warn); box-shadow: 0 0 10px var(--status-warn); }
  .knowledge-lamp[data-status="offline"] .kl-dot { background: var(--status-error); }

  .ask-layout { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 14px; }
  @media (max-width: 980px) { .ask-layout { grid-template-columns: 1fr; } }
  .ask-thread {
    min-height: 280px; max-height: 440px; overflow-y: auto; display: flex; flex-direction: column; gap: 12px;
    padding: 4px 2px;
  }
  .ask-bubble {
    border: 1px solid var(--separator); border-radius: 14px; padding: 12px 14px; background: var(--surface-muted);
  }
  .ask-bubble.user { border-color: rgba(59,130,246,0.35); background: rgba(59,130,246,0.1); }
  .ask-bubble.assistant { border-color: rgba(56,189,248,0.28); }
  .ask-bubble.abstain { border-color: rgba(245,166,35,0.45); background: rgba(245,166,35,0.08); }
  .ask-meta { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 8px; font-size: 0.82rem; color: var(--text-muted); }
  .ask-badge {
    display: inline-flex; align-items: center; padding: 2px 8px; border-radius: 999px; font-weight: 650;
    letter-spacing: 0.04em; text-transform: uppercase; font-size: 0.72rem; border: 1px solid var(--separator);
  }
  .ask-badge.high { color: var(--status-ok); border-color: rgba(34,197,94,0.4); }
  .ask-badge.medium { color: var(--status-warn); border-color: rgba(245,166,35,0.4); }
  .ask-badge.low { color: var(--status-error); border-color: rgba(239,68,68,0.4); }
  .ask-answer { white-space: pre-wrap; color: var(--text-secondary); font-size: 0.95rem; line-height: 1.55; }
  .ask-answer code {
    font-family: var(--font-mono); font-size: 0.86em; background: rgba(0,0,0,0.28); padding: 1px 5px; border-radius: 6px;
  }
  .ask-cites { margin-top: 10px; display: flex; flex-direction: column; gap: 6px; }
  .ask-cite {
    font-size: 0.85rem; color: var(--text-muted); padding: 8px 10px; border-radius: 10px;
    border: 1px solid var(--separator); background: rgba(0,0,0,0.18);
  }
  .ask-cite a { color: var(--accent-2); text-decoration: none; }
  .ask-cite a:hover { text-decoration: underline; }
  .ask-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .ask-chip {
    cursor: pointer; border: 1px solid var(--separator); background: var(--surface-muted); color: var(--text-secondary);
    border-radius: 999px; padding: 6px 12px; font-size: 0.82rem;
  }
  .ask-chip:hover { border-color: rgba(59,130,246,0.45); color: var(--text-primary); }
  .ask-hint { font-size: 0.82rem; color: var(--text-muted); margin-top: 8px; }

  .glass {
    background: linear-gradient(165deg, rgba(255,255,255,0.035), transparent 42%), var(--surface-base);
    border: 1px solid var(--separator); box-shadow: var(--glass-shadow); border-radius: var(--radius-liquid);
    backdrop-filter: blur(14px) saturate(1.15); -webkit-backdrop-filter: blur(14px) saturate(1.15);
  }

  .hero {
    position: relative; overflow: hidden; border: 1px solid var(--separator); border-radius: calc(var(--radius-liquid) + 4px);
    background:
      radial-gradient(ellipse 80% 70% at 0% 0%, rgba(59,130,246,0.16), transparent 55%),
      radial-gradient(ellipse 60% 50% at 100% 0%, rgba(56,189,248,0.08), transparent 50%),
      linear-gradient(180deg, rgba(34,197,94,0.06), transparent 45%),
      rgba(14, 20, 32, 0.9);
    box-shadow: var(--glass-shadow); padding: clamp(22px, 2.2vw, 32px) clamp(20px, 2vw, 34px); margin-bottom: 22px;
    animation: rise 0.55s var(--ease-out) 0.04s both;
  }
  .hero-shine { display: block; position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .hero-shine::after {
    content: ""; position: absolute; top: 0; left: 0; width: 42%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.07), transparent);
    animation: shimmer 7s ease-in-out infinite;
  }
  .hero-head { position: relative; display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .icon-badge {
    display: flex; align-items: center; justify-content: center; width: 3.6rem; height: 3.6rem; border-radius: 16px; flex: none;
    background: linear-gradient(150deg, rgba(59,130,246,0.4), rgba(56,189,248,0.12));
    border: 1px solid rgba(56,189,248,0.35); box-shadow: 0 0 24px -4px rgba(59,130,246,0.45);
  }
  .hero h1 { font-family: var(--font-mono); font-size: clamp(1.7rem, 2.4vw, 2.25rem); font-weight: 750; letter-spacing: 0.01em; margin: 0; }
  .hero .subtitle { color: var(--text-secondary); font-size: 0.98rem; margin-top: 5px; }
  .hero .sync { margin-left: auto; color: var(--text-muted); font-size: 0.875rem; }
  .status-line { display: inline-flex; align-items: center; gap: 8px; }
  .status-line .lamp { width: 12px; height: 12px; border-radius: 50%; flex: none; }
  .hero[data-status="go"] .lamp { background: var(--status-ok); box-shadow: 0 0 14px var(--status-ok); }
  .hero[data-status="go"] h1 span { color: var(--status-ok); }
  .hero[data-status="go"] { animation: soft-glow 3.5s ease-in-out infinite; }
  .hero[data-status="degraded"] .lamp { background: var(--status-warn); box-shadow: 0 0 14px var(--status-warn); }
  .hero[data-status="degraded"] h1 span { color: var(--status-warn); }
  .hero[data-status="down"] .lamp { background: var(--status-error); box-shadow: 0 0 14px var(--status-error); animation: pulse 1.1s infinite; }
  .hero[data-status="down"] h1 span { color: var(--status-error); }
  .hero[data-status="offline"] .lamp { background: var(--status-neutral); }
  .hero[data-status="offline"] h1 span { color: var(--text-secondary); }

  .stat-grid { position: relative; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; margin-top: 22px; }
  .stat-tile {
    display: flex; flex-direction: column; gap: 0.4rem; padding: 1.05rem 1.2rem; border-radius: 14px;
    border: 1px solid var(--separator); background: linear-gradient(160deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));
    transition: transform 0.25s var(--ease-out), border-color 0.2s, background 0.2s;
  }
  .stat-tile:hover { transform: translateY(-2px); border-color: rgba(59,130,246,0.4); background: linear-gradient(160deg, rgba(59,130,246,0.1), rgba(255,255,255,0.02)); }
  .stat-label { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); }
  .stat-value { font-size: 1.65rem; font-weight: 800; letter-spacing: -0.03em; color: var(--text-primary); font-variant-numeric: tabular-nums; }
  .stat-sub { font-size: 0.82rem; color: var(--text-muted); }

  h2 {
    font-family: var(--font-mono); font-size: 0.78rem; font-weight: 650; text-transform: uppercase; color: var(--text-muted);
    margin: 34px 0 14px; letter-spacing: 0.14em; display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
  }
  h2::after { content: ""; flex: 1; min-width: 40px; height: 1px; background: linear-gradient(90deg, var(--separator), transparent); }

  .strip { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; animation: rise 0.5s var(--ease-out) 0.08s both; }
  .card { padding: 18px 20px; }
  .card .k { color: var(--text-muted); font-size: 0.82rem; font-family: var(--font-mono); }
  .card .v { font-size: 1.4rem; font-weight: 650; letter-spacing: -0.02em; margin-top: 2px; font-variant-numeric: tabular-nums; }
  .card .d { color: var(--text-secondary); font-size: 0.875rem; margin-top: 4px; }

  .pods { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; animation: rise 0.5s var(--ease-out) 0.1s both; }
  .pod { cursor: pointer; transition: background-color .18s, border-color .18s, transform .22s var(--ease-out), box-shadow .22s; }
  .pod:hover { background-color: var(--surface-elevated); border-color: var(--glass-border-strong); transform: translateY(-2px); box-shadow: 0 12px 28px -18px rgba(0,0,0,0.7); }
  .pod .row { display: flex; align-items: center; gap: 9px; }
  .pod .dot { width: 10px; height: 10px; border-radius: 50%; flex: none; animation: pulse 2.4s infinite; }
  .pod .name { font-weight: 600; font-size: 0.95rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pod .phase { margin-left: auto; font-size: 0.8rem; color: var(--text-secondary); white-space: nowrap; }
  .pod .meta { display: flex; gap: 12px; flex-wrap: wrap; color: var(--text-muted); font-size: 0.85rem; margin-top: 10px; }
  .pod .meta b { color: var(--text-secondary); font-weight: 600; font-variant-numeric: tabular-nums; }
  .pod .restarts-bad { color: var(--status-error); font-weight: 700; }
  .pod .warn { color: var(--status-warn); font-size: 0.85rem; margin-top: 9px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .empty { color: var(--text-secondary); padding: 22px 24px; font-size: 0.95rem; border: 1px dashed rgba(148,168,200,0.22); border-radius: var(--radius-liquid); background: var(--surface-muted); }
  .empty code { font-family: var(--font-mono); color: var(--text-primary); background: var(--fill-secondary); padding: 2px 7px; border-radius: 6px; }

  .qa { display: grid; grid-template-columns: minmax(260px, 1fr) minmax(0, 2.4fr) minmax(260px, 1fr); gap: 16px; animation: rise 0.55s var(--ease-out) 0.12s both; }
  @media (max-width: 1280px) { .qa { grid-template-columns: minmax(240px, 1fr) minmax(0, 2fr); } }
  @media (max-width: 800px) { .qa { grid-template-columns: 1fr; } }
  .spark-wrap { position: relative; }
  .spark-tip {
    position: absolute; pointer-events: none; display: none; background: var(--surface-strong); border: 1px solid var(--glass-border-strong);
    border-radius: 10px; backdrop-filter: blur(var(--blur-liquid)); -webkit-backdrop-filter: blur(var(--blur-liquid));
    padding: 6px 12px; font-size: 0.85rem; color: var(--text-primary); white-space: nowrap; z-index: 2; box-shadow: var(--glass-shadow);
  }
  .runs-table { width: 100%; border-collapse: collapse; }
  .runs-table tr { transition: background 0.12s ease; }
  .runs-table tr:hover { background: var(--fill-secondary); }
  .runs-table td { padding: 10px 12px; border-bottom: 1px solid var(--separator); font-size: 0.95rem; color: var(--text-secondary); }
  .runs-table td:first-child { color: var(--text-muted); font-size: 0.85rem; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .chip { display: inline-flex; align-items: center; padding: 3px 11px; border-radius: 9999px; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.02em; border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.05); }
  .chip.pass { color: var(--status-ok); border-color: rgba(34,197,94,0.35); background: rgba(34,197,94,0.08); }
  .chip.fail { color: var(--status-error); border-color: rgba(239,68,68,0.35); background: rgba(239,68,68,0.08); }

  .drawer {
    position: fixed; top: 0; right: 0; bottom: 0; width: min(760px, 94vw);
    background: linear-gradient(180deg, rgba(26,35,50,0.98), rgba(14,20,32,0.98));
    backdrop-filter: blur(22px) saturate(1.25); -webkit-backdrop-filter: blur(22px) saturate(1.25);
    border-left: 1px solid var(--glass-border-strong); box-shadow: -24px 0 60px rgba(0,0,0,0.45);
    transform: translateX(100%); transition: transform .28s var(--ease-out); z-index: 20; display: flex; flex-direction: column;
  }
  .drawer.open { transform: translateX(0); }
  .drawer header { padding: 16px 20px; border-bottom: 1px solid var(--separator); display: flex; align-items: center; }
  .drawer header b { font-family: var(--font-mono); font-size: 0.95rem; }
  .drawer header .close {
    margin-left: auto; cursor: pointer; color: var(--text-secondary); background: var(--surface-muted); border: 1px solid var(--separator);
    border-radius: 9999px; width: 32px; height: 32px; font-size: 15px; line-height: 1; transition: color .15s, background .15s, transform .15s;
  }
  .drawer header .close:hover { color: var(--text-primary); background: var(--fill-secondary); transform: scale(1.05); }
  .drawer pre { flex: 1; overflow: auto; margin: 0; padding: 16px 20px; font-family: var(--font-mono); font-size: 0.85rem; line-height: 1.65; color: var(--text-secondary); white-space: pre-wrap; word-break: break-all; }

  .run-btn {
    cursor: pointer; padding: 8px 16px; border-radius: 9999px; font-size: 0.9rem; font-weight: 650; color: var(--text-primary);
    background: rgba(255,255,255,0.06); border: 1px solid var(--separator); font-family: var(--font-base);
    transition: background .18s, border-color .18s, box-shadow .18s, transform .18s var(--ease-out);
  }
  .run-btn:hover:not(:disabled) { background: rgba(59,130,246,0.22); border-color: var(--accent); box-shadow: 0 0 0 3px rgba(59,130,246,0.14); transform: translateY(-1px); }
  .run-btn:active:not(:disabled) { transform: translateY(0); }
  .run-btn:disabled { opacity: 0.45; cursor: not-allowed; }
  .run-btn.primary {
    background: linear-gradient(135deg, rgba(59,130,246,0.95), rgba(56,189,248,0.75));
    border-color: transparent; color: #fff; box-shadow: 0 8px 22px -10px rgba(59,130,246,0.7);
  }
  .run-btn.primary:hover:not(:disabled) { background: linear-gradient(135deg, #60a5fa, #38bdf8); box-shadow: 0 10px 26px -8px rgba(59,130,246,0.85); }
  .run-status { font-size: 0.875rem; font-weight: 400; color: var(--text-secondary); display: inline-flex; align-items: center; gap: 6px; }
  .run-status .spin { width: 9px; height: 9px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 8px var(--accent); animation: pulse 1.2s infinite; }
  .run-status.err { color: var(--status-error); }
  .livecase { display: inline-flex; align-items: center; gap: 5px; margin: 2px 6px 2px 0; font-size: 0.875rem; }
  .livecase .dot { width: 8px; height: 8px; border-radius: 50%; flex: none; }
  .livecase.pass .dot { background: var(--status-ok); }
  .livecase.fail .dot { background: var(--status-error); }
  .livecase.fail { color: var(--status-error); }
  .err-summary { border: 1px solid rgba(255,69,58,0.35); background: rgba(255,69,58,0.06); border-radius: 12px; padding: 14px 16px; margin: 10px 0; }
  .err-summary .k { color: var(--status-error); font-weight: 600; font-size: 0.875rem; margin-bottom: 6px; }
  .case-err { color: #fca5a5; font-family: var(--font-mono); font-size: 0.8rem; white-space: pre-wrap; max-width: none; }
  .copy-btn { cursor: pointer; font-size: 0.8rem; color: var(--text-muted); background: none; border: none; padding: 0 4px; }
  .copy-btn:hover { color: var(--text-primary); }
  .dl-row { display: flex; gap: 8px; align-items: center; margin-top: 10px; flex-wrap: wrap; }
  .dl-row a, .dl-row button { text-decoration: none; }

  .acts { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr)); gap: 16px; }
  @media (min-width: 1600px) { .acts { grid-template-columns: repeat(auto-fill, minmax(400px, 1fr)); gap: 18px; } }
  .brand-eyebrow {
    font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.18em; font-weight: 650;
    background: linear-gradient(110deg, var(--accent), var(--accent-2), var(--accent-hot));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .act-title { font-weight: 700; font-size: 1.05rem; margin-bottom: 12px; letter-spacing: -0.015em; line-height: 1.35; }
  .act { position: relative; overflow: hidden; transition: border-color .2s, box-shadow .25s var(--ease-out), transform .25s var(--ease-out); animation: rise 0.5s var(--ease-out) both; }
  .act::before {
    content: ""; position: absolute; left: 0; top: 12px; bottom: 12px; width: 3px; border-radius: 0 3px 3px 0;
    background: linear-gradient(180deg, var(--accent), var(--accent-2)); opacity: 0.85;
  }
  .act:nth-child(4n+2)::before { background: linear-gradient(180deg, #38bdf8, #22d3ee); }
  .act:nth-child(4n+3)::before { background: linear-gradient(180deg, #a78bfa, #818cf8); }
  .act:nth-child(4n+4)::before { background: linear-gradient(180deg, #34d399, #22c55e); }
  .act:nth-child(1) { animation-delay: 0.02s; } .act:nth-child(2) { animation-delay: 0.04s; }
  .act:nth-child(3) { animation-delay: 0.06s; } .act:nth-child(4) { animation-delay: 0.08s; }
  .act:nth-child(5) { animation-delay: 0.1s; } .act:nth-child(6) { animation-delay: 0.12s; }
  .act:nth-child(7) { animation-delay: 0.14s; } .act:nth-child(8) { animation-delay: 0.16s; }
  .act:nth-child(n+9) { animation-delay: 0.18s; }
  .act:hover {
    border-color: rgba(59,130,246,0.5);
    box-shadow: 0 18px 40px -24px rgba(59,130,246,0.45), inset 0 1px 0 rgba(255,255,255,0.06);
    transform: translateY(-3px);
  }
  .act-row { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; flex-wrap: wrap; }
  .act-row:last-child { margin-bottom: 0; }
  .inp {
    background: rgba(255,255,255,0.06); border: 1px solid var(--separator); color: var(--text-primary);
    border-radius: 0.7rem; padding: 8px 12px; font-size: 0.9rem; font-family: var(--font-base); min-height: 2.4rem;
    transition: border-color .15s, box-shadow .15s, background .15s;
  }
  .inp:hover { border-color: rgba(148,168,200,0.28); }
  .inp:focus { outline: none; border-color: rgba(59,130,246,0.6); box-shadow: 0 0 0 3px rgba(59,130,246,0.18); background: rgba(255,255,255,0.08); }
  .inp.grow { flex: 1; min-width: 140px; }
  textarea.inp { resize: vertical; min-height: 4.5rem; line-height: 1.5; }
  select.inp { cursor: pointer; }
  .chk { display: inline-flex; align-items: center; gap: 7px; font-size: 0.875rem; color: var(--text-secondary); }
  .chk input { accent-color: var(--accent); width: 1rem; height: 1rem; }
  .result-title { font-weight: 600; font-size: 1rem; margin-bottom: 10px; display: flex; align-items: center; gap: 10px; }
  .result-files { font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-secondary); line-height: 1.7; }
  .result-err { color: var(--status-error); font-size: 0.95rem; }
  .rlink { color: var(--accent-2); text-decoration: none; font-size: 0.875rem; }
  .rlink:hover { text-decoration: underline; }

  #job-live {
    border-color: rgba(59,130,246,0.45);
    box-shadow: 0 0 0 1px rgba(59,130,246,0.12), 0 20px 50px -30px rgba(59,130,246,0.55);
    background: linear-gradient(135deg, rgba(59,130,246,0.1), transparent 40%), var(--surface-base);
  }
  #live-log {
    font-size: 0.85rem !important; max-height: 280px !important; line-height: 1.7 !important;
    background: rgba(0,0,0,0.28); border: 1px solid var(--separator); border-radius: 12px; padding: 12px 14px !important;
  }
  #job-result video, #job-result img { max-width: min(920px, 100%) !important; border-radius: 12px; }

  #toasts { position: fixed; top: 18px; right: 18px; z-index: 50; display: flex; flex-direction: column; gap: 10px; }
  .toast {
    background-color: rgba(26,35,50,0.92); border: 1px solid var(--glass-border-strong);
    backdrop-filter: blur(var(--blur-liquid)); -webkit-backdrop-filter: blur(var(--blur-liquid));
    border-radius: 14px; padding: 12px 18px; box-shadow: var(--glass-shadow); font-size: 0.95rem;
    display: flex; align-items: center; gap: 10px; min-width: 260px; animation: toast-in .28s var(--ease-out);
  }
  .toast.ok { border-left: 3px solid var(--status-ok); }
  .toast.bad { border-left: 3px solid var(--status-error); }
  .toast .t-kind { font-weight: 600; }
  .toast .t-sub { color: var(--text-secondary); font-size: 0.85rem; }

  .feed { display: flex; flex-direction: column; gap: 0; max-height: 340px; overflow-y: auto; }
  .feed-item { display: flex; align-items: baseline; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--separator); font-size: 0.875rem; }
  .feed-item:last-child { border-bottom: none; }
  .feed-item .f-when { color: var(--text-muted); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .feed-item .f-kind { font-weight: 600; white-space: nowrap; }
  .feed-item .f-brief { color: var(--text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pod-search { margin-left: 10px; width: min(240px, 40vw); font-weight: 400; }
  .trend-up { color: var(--status-ok); }
  .trend-down { color: var(--status-error); }
  .drawer-controls { display: flex; align-items: center; gap: 8px; padding: 10px 18px; border-bottom: 1px solid var(--separator); flex-wrap: wrap; }
  .drawer-controls .inp { padding: 6px 10px; font-size: 0.85rem; min-height: 2rem; }
  .drawer-controls .chk { font-size: 0.85rem; }
  .dl-btn {
    cursor: pointer; font-size: 0.8rem; padding: 6px 12px; border-radius: 9999px; color: var(--text-secondary);
    background: var(--surface-muted); border: 1px solid var(--separator); transition: color .15s, background .15s, border-color .15s, transform .15s;
  }
  .dl-btn:hover { color: var(--text-primary); background: var(--fill-secondary); border-color: var(--glass-border-strong); transform: translateY(-1px); }
  .runs-table tr.expandable { cursor: pointer; }
  .run-detail td { background: var(--surface-muted); font-size: 0.875rem; color: var(--text-secondary); white-space: pre-wrap; padding: 12px 14px; }

  #palette {
    position: fixed; inset: 0; z-index: 55; background: rgba(2,6,14,0.62);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    display: flex; align-items: flex-start; justify-content: center; padding-top: 12vh; animation: rise 0.2s var(--ease-out);
  }
  .palette-box { width: min(680px, 94vw); border-radius: 18px; padding: 14px; box-shadow: 0 30px 80px -20px rgba(0,0,0,0.7), 0 0 0 1px rgba(59,130,246,0.2); }
  #palette-input { width: 100%; font-size: 1.08rem; padding: 14px 16px; margin-bottom: 8px; min-height: 2.85rem; }
  .palette-item { padding: 12px 14px; border-radius: 12px; cursor: pointer; display: flex; align-items: center; gap: 10px; font-size: 1rem; transition: background .12s; }
  .palette-item.sel { background: rgba(59,130,246,0.22); }
  .palette-item .pk { color: var(--text-muted); margin-left: auto; font-size: 0.8rem; }

  footer {
    position: sticky; bottom: 10px; z-index: 7; margin-top: 36px; color: var(--text-muted); font-size: 0.85rem;
    display: flex; gap: 14px; flex-wrap: wrap; align-items: center; padding: 10px 16px; border-radius: 999px;
    border: 1px solid var(--separator); background: rgba(10, 14, 22, 0.78);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); box-shadow: var(--glass-shadow);
  }
  kbd { border: 1px solid var(--separator); border-radius: 6px; padding: 1px 7px; font-size: 0.8rem; font-family: var(--font-mono); background: var(--surface-muted); color: var(--text-secondary); }


  /* —— Surprise layer: boot · constellation · NOC warp —— */
  #signal-field {
    position: fixed; inset: 0; z-index: 0; pointer-events: none; opacity: 0.55;
  }
  #boot-splash {
    position: fixed; inset: 0; z-index: 100; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 18px; text-align: center;
    background: radial-gradient(ellipse at center, #0f1a2e 0%, #05070c 70%);
    transition: opacity 0.7s var(--ease-out), visibility 0.7s;
  }
  #boot-splash.hide { opacity: 0; visibility: hidden; pointer-events: none; }
  #boot-splash .boot-mark {
    width: 72px; height: 72px; border-radius: 20px;
    display: grid; place-items: center;
    background: linear-gradient(145deg, rgba(59,130,246,0.35), rgba(56,189,248,0.12));
    border: 1px solid rgba(56,189,248,0.45);
    box-shadow: 0 0 40px rgba(59,130,246,0.45);
    animation: soft-glow 2s ease-in-out infinite;
  }
  #boot-splash .boot-title {
    font-family: var(--font-mono); font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 750;
    letter-spacing: 0.28em; text-transform: uppercase;
    background: linear-gradient(110deg, #93c5fd, #e2e8f0, #38bdf8);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  #boot-splash .boot-sub { color: var(--text-muted); font-size: 0.95rem; letter-spacing: 0.08em; }
  #boot-splash .boot-bar {
    width: min(280px, 60vw); height: 3px; border-radius: 999px; overflow: hidden;
    background: rgba(148,168,200,0.15);
  }
  #boot-splash .boot-bar > i {
    display: block; height: 100%; width: 0%;
    background: linear-gradient(90deg, #3b82f6, #38bdf8, #a78bfa);
    animation: boot-fill 1.45s var(--ease-out) forwards;
  }
  @keyframes boot-fill { to { width: 100%; } }

  body.noc-mode { --bg: #03050a; }
  body.noc-mode main { padding-top: 8px; }
  body.noc-mode .topbar { border-color: rgba(56,189,248,0.35); box-shadow: 0 0 30px rgba(56,189,248,0.12); }
  body.noc-mode .act { transform: none; }
  body.noc-mode h2 { letter-spacing: 0.22em; color: #7dd3fc; }
  body.noc-mode #signal-field { opacity: 0.85; }
  body.noc-mode .hero { border-color: rgba(56,189,248,0.4); }

  #warp-flash {
    position: fixed; inset: 0; z-index: 90; pointer-events: none; opacity: 0;
    background: radial-gradient(circle at 50% 40%, rgba(56,189,248,0.35), transparent 55%);
    transition: opacity 0.15s ease;
  }
  #warp-flash.on { opacity: 1; }

  .achieve-toast {
    position: fixed; left: 50%; bottom: 88px; transform: translateX(-50%) translateY(20px);
    z-index: 70; min-width: 280px; max-width: 90vw; padding: 14px 20px; border-radius: 16px;
    background: linear-gradient(135deg, rgba(15,23,42,0.95), rgba(30,41,59,0.92));
    border: 1px solid rgba(56,189,248,0.45); box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    opacity: 0; transition: opacity .35s var(--ease-out), transform .35s var(--ease-out);
    text-align: center; pointer-events: none;
  }
  .achieve-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
  .achieve-toast .a-kicker {
    font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.2em; color: #7dd3fc; margin-bottom: 4px;
  }
  .achieve-toast .a-title { font-weight: 750; font-size: 1.05rem; }
  .achieve-toast .a-sub { color: var(--text-secondary); font-size: 0.85rem; margin-top: 2px; }

  .topbar-brand { cursor: pointer; user-select: none; }
  .topbar-brand:hover { color: #e2e8f0; }
  .icon-badge { cursor: pointer; }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
  }
</style>
</head>
<body>

<canvas id="signal-field" aria-hidden="true"></canvas>
<div id="warp-flash" aria-hidden="true"></div>
<div id="boot-splash" role="status" aria-live="polite">
  <div class="boot-mark" aria-hidden="true">
    <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#7dd3fc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
  </div>
  <div class="boot-title">Mission Control</div>
  <div class="boot-sub" id="boot-sub">calibrating signal field…</div>
  <div class="boot-bar"><i></i></div>
</div>
<div class="achieve-toast" id="achieve-toast" aria-live="polite">
  <div class="a-kicker">ACHIEVEMENT UNLOCKED</div>
  <div class="a-title" id="achieve-title">—</div>
  <div class="a-sub" id="achieve-sub"></div>
</div>

<main>
  <div class="topbar">
    <div class="topbar-brand"><span class="topbar-dot" aria-hidden="true"></span> Zyvor Mission Control</div>
    <div class="topbar-spacer"></div>
    <div class="topbar-hint"><kbd>⌘K</kbd> command palette</div>
    <span class="knowledge-lamp" id="knowledge-lamp" data-status="offline" title="Knowledge agent status">
      <span class="kl-dot" aria-hidden="true"></span>
      <span id="knowledge-lamp-label">Knowledge offline</span>
    </span>
    <button type="button" class="run-btn primary" id="topbar-palette">Open commands</button>
  </div>
  <div class="hero" data-status="offline" id="hero">
    <div class="hero-shine" aria-hidden="true"></div>
    <div class="hero-head">
      <div class="icon-badge" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
        </svg>
      </div>
      <div>
        <div class="brand-eyebrow">ZYVOR QA · MISSION CONTROL</div>
        <h1><span id="banner-title">STANDBY</span></h1>
        <div class="subtitle status-line"><span class="lamp"></span><span id="banner-sub">waiting for first sync</span></div>
      </div>
      <span class="sync" style="display:flex;flex-direction:column;align-items:flex-end;gap:4px">
        <span id="sync">connecting…</span>
        <span id="session" style="display:none">🔐 <b id="session-user"></b> · <a class="rlink" href="#" id="logout">sign out</a></span>
      </span>
    </div>
    <div class="stat-grid">
      <div class="stat-tile"{% if desktop_mode %} style="display:none"{% endif %}><span class="stat-label">Pods</span><span class="stat-value" id="stat-pods">—</span><span class="stat-sub" id="stat-pods-sub"></span></div>
      <div class="stat-tile"{% if desktop_mode %} style="display:none"{% endif %}><span class="stat-label">Replicas</span><span class="stat-value" id="stat-replicas">—</span><span class="stat-sub" id="stat-replicas-sub"></span></div>
      <div class="stat-tile"><span class="stat-label">Last QA run</span><span class="stat-value" id="stat-run">—</span><span class="stat-sub" id="stat-run-sub"></span></div>
      <div class="stat-tile"><span class="stat-label">Pass rate</span><span class="stat-value" id="stat-rate">—</span><span class="stat-sub" id="stat-rate-sub">last 30 runs</span></div>
      <div class="stat-tile"><span class="stat-label">Next smoke run</span><span class="stat-value" id="stat-cron">—</span><span class="stat-sub" id="stat-cron-sub"></span></div>
      <div class="stat-tile"><span class="stat-label">Knowledge</span><span class="stat-value" id="stat-knowledge">—</span><span class="stat-sub" id="stat-knowledge-sub">Ask Zyvor</span></div>
    </div>
  </div>

  {# The desktop app wraps a local, cluster-less argus serve — this whole
     section is always "cluster unavailable" there, so it's just clutter.
     CSS-hidden rather than removed from the DOM: the polling JS below still
     targets these ids by getElementById() and isn't cluster-aware, so
     omitting the elements outright would throw on every refresh cycle. #}
  <div{% if desktop_mode %} style="display:none"{% endif %}>
  <h2>Workloads</h2>
  <div class="strip" id="workloads"><div class="empty">No workload data yet.</div></div>

  <h2 style="display:flex;align-items:center">Pods <span style="color:var(--text-muted);font-weight:400;margin-left:6px" id="ns"></span>
    <input class="inp pod-search" id="pod-search" placeholder="filter pods…">
    <button class="dl-btn" id="events-toggle" style="margin-left:8px">⚡ events</button>
  </h2>
  <div class="glass card" id="events-panel" style="display:none;margin-bottom:14px">
    <div class="k" style="margin-bottom:8px">Recent cluster events</div>
    <div style="overflow-x:auto"><table class="runs-table" id="events-table"><tbody></tbody></table></div>
  </div>
  <div class="pods" id="pods"><div class="empty">No pod data yet.</div></div>
  </div>

  <h2 style="display:flex;align-items:center;gap:12px">Actions <span id="run-status" class="run-status"></span></h2>

  <div class="glass card" id="job-live" style="display:none;margin-bottom:14px">
    <div class="result-title" style="margin-bottom:10px">
      <span class="spin" style="width:10px;height:10px;border-radius:50%;background:var(--accent);box-shadow:0 0 8px var(--accent);animation:pulse 1.2s infinite"></span>
      <span id="live-kind">job</span> running
      <span class="d" id="live-elapsed" style="font-weight:400"></span>
      <span id="live-tally" style="font-weight:400"></span>
      <button class="dl-btn" id="btn-copylog" style="margin-left:auto">⧉ copy log</button>
      <button class="dl-btn" id="btn-dllog">⬇ .txt</button>
      <button class="run-btn" id="btn-stop" style="color:var(--status-error);border-color:rgba(255,69,58,0.4)">⏹ Stop</button>
    </div>
    <div id="live-cases" style="margin-bottom:10px"></div>
    <pre id="live-log" style="margin:0;max-height:280px;overflow-y:auto;font-family:var(--font-mono);font-size:0.85rem;line-height:1.7;color:var(--text-secondary);white-space:pre-wrap"></pre>
  </div>
  <div class="acts">
    <div class="glass card act">
      <div class="act-title">▶ Run tests</div>
      <div class="act-row">
        <select class="inp" id="run-source"><option value="local">local</option><option value="github">github</option></select>
        <input class="inp grow" id="run-spec" placeholder="spec path (optional)" list="spec-list">
      </div>
      <div class="act-row">
        <input class="inp" id="run-pr" type="number" placeholder="PR #" style="width:80px">
        <label class="chk"><input type="checkbox" id="run-coverage"> expand coverage</label>
      </div>
      <div class="act-row">
        <input class="inp grow" id="sm-grep" placeholder="grep tag (e.g. @smoke)" style="max-width:180px">
        <input class="inp" id="sm-shard" placeholder="shard 1/2" style="max-width:100px">
        <button class="run-btn primary act-btn" data-kind="smoke">▶ Smoke</button>
        <button class="run-btn act-btn" data-kind="full">▶ Full pipeline</button>
      </div>
    </div>
    <div class="glass card act">
      <div class="act-title">⚙ Generate tests</div>
      <div class="act-row">
        <select class="inp" id="gen-source"><option value="local">local</option><option value="github">github</option></select>
        <input class="inp grow" id="gen-spec" placeholder="spec path (optional)" list="spec-list">
      </div>
      <div class="act-row"><label class="chk"><input type="checkbox" id="gen-coverage"> expand coverage</label></div>
      <div class="act-row"><button class="run-btn act-btn" data-kind="generate">⚙ Generate</button></div>
    </div>
    <div class="glass card act">
      <div class="act-title">🔎 Discover coverage</div>
      <div class="d" style="margin-bottom:8px">Scan repo code/docs for untested routes and pages.</div>
      <div class="act-row">
        <select class="inp" id="disc-source"><option value="github">github</option><option value="local">local</option></select>
        <button class="run-btn act-btn" data-kind="discover">🔎 Discover</button>
      </div>
    </div>
    <div class="glass card act">
      <div class="act-title">✨ Create from English <span class="d" style="font-weight:400">— AI when a key is set, heuristic otherwise</span></div>
      <div class="act-row"><textarea class="inp grow" id="nl-desc" rows="2" placeholder="e.g. Verify /vm page mentions KubeVirt migration"></textarea></div>
      <div class="act-row" id="nl-chips" style="gap:6px">
        <span class="chip nl-chip" style="cursor:pointer">homepage shows all products</span>
        <span class="chip nl-chip" style="cursor:pointer">/vm mentions KubeVirt</span>
        <span class="chip nl-chip" style="cursor:pointer">Schedule Demo button works</span>
      </div>
      <div class="act-row">
        <label class="chk"><input type="checkbox" id="nl-execute"> run immediately</label>
        <button class="run-btn act-btn" data-kind="create">✨ Create</button>
      </div>
    </div>
    <div class="glass card act">
      <div class="act-title">👁 Visual regression</div>
      <div class="d" style="margin-bottom:8px">Pixel-compare screenshots against baselines.</div>
      <div class="act-row">
        <label class="chk"><input type="checkbox" id="reg-update"> update baselines</label>
        <button class="run-btn act-btn" data-kind="regression">👁 Regression</button>
      </div>
    </div>
    <div class="glass card act" style="grid-column: 1 / -1">
      <div class="act-title">🔬 Site audit — accessibility, links, SEO, performance, security per page</div>
      <div class="act-row">
        <input class="inp grow" id="au-url" placeholder="https://your-app.example.com">
        <input class="inp" id="au-pages" type="number" value="10" min="1" max="100" style="width:80px" title="max pages">
        <label class="chk"><input type="checkbox" id="au-insecure"> self-signed TLS</label>
      </div>
      <div class="act-row" id="au-checks" style="gap:12px">
        <label class="chk"><input type="checkbox" value="a11y" checked> a11y</label>
        <label class="chk"><input type="checkbox" value="links" checked> links</label>
        <label class="chk"><input type="checkbox" value="seo" checked> SEO</label>
        <label class="chk"><input type="checkbox" value="console" checked> console</label>
        <label class="chk"><input type="checkbox" value="perf" checked> perf</label>
        <label class="chk"><input type="checkbox" value="headers" checked> headers</label>
        <label class="chk"><input type="checkbox" value="responsive"> responsive</label>
        <button class="run-btn act-btn" data-kind="audit" style="margin-left:auto">🔬 Run audit</button>
      </div>
    </div>
    <div class="glass card act">
      <div class="act-title">🎲 Flaky check — run repeatedly, find unstable tests</div>
      <div class="act-row">
        <span class="d">runs</span>
        <input class="inp" id="fl-runs" type="number" value="3" min="2" max="10" style="width:70px">
        <button class="run-btn act-btn" data-kind="flaky" style="margin-left:auto">🎲 Detect flaky</button>
      </div>
    </div>
    <div class="glass card act">
      <div class="act-title">🔀 Compare — visual diff two URLs (staging vs prod)</div>
      <div class="act-row"><input class="inp grow" id="cmp-a" placeholder="URL A (e.g. staging)"></div>
      <div class="act-row"><input class="inp grow" id="cmp-b" placeholder="URL B (e.g. prod)"></div>
      <div class="act-row">
        <label class="chk"><input type="checkbox" id="cmp-insecure"> self-signed TLS</label>
        <button class="run-btn act-btn" data-kind="compare" style="margin-left:auto">🔀 Compare</button>
      </div>
