  if (rerun) rerun.addEventListener("click", async () => {
    const res = await fetch("/api/dashboard/jobs/rerun", { method: "POST" });
    if (res.status === 409) { toast("rerun", false, "a job is already running"); return; }
    $("job-result").style.display = "none";
    sync();
  });
  const copyMd = document.getElementById("btn-copy-md");
  if (copyMd) copyMd.addEventListener("click", async () => {
    try {
      const md = await fetch("/api/dashboard/jobs/report.md").then((res) => res.text());
      await navigator.clipboard.writeText(md);
      toast("report", true, "Markdown copied — paste into a GitHub issue, PR, or Slack message");
    } catch (err) {
      toast("report", false, "Clipboard unavailable");
    }
  });
}

/* fast 2s status poll while a job is running, so the live log streams */
let busyPoll = null;
function ensureBusyPoll(busy) {
  if (busy && !busyPoll) {
    busyPoll = setInterval(async () => {
      try {
        const st = await fetch("/api/dashboard/jobs/status").then((r) => r.json());
        renderRunStatus(st);
        if (!st.running) {
          clearInterval(busyPoll); busyPoll = null; sync();
          if (videosOpen) loadVideos();
        }
      } catch (e) { /* next tick */ }
    }, 2000);
  } else if (!busy && busyPoll) {
    clearInterval(busyPoll); busyPoll = null;
  }
}

async function sync() {
  try {
    const [overview, pods, runs, runSt] = await Promise.all([
      fetch("/api/dashboard/overview").then((r) => r.json()),
      fetch("/api/dashboard/pods").then((r) => r.json()),
      fetch("/api/dashboard/runs").then((r) => r.json()),
      fetch("/api/dashboard/jobs/status").then((r) => r.json()),
    ]);
    const runList = runs.runs || [];
    renderHero(overview, pods, runList);
    try {
      const recent = (runList || []).slice(0, 30);
      const ok = recent.filter(r => (r.failed|0) === 0 && ((r.passed|0) > 0 || (r.total|0) === 0)).length;
      const rate = recent.length ? ok / recent.length : 0.4;
      const st = document.getElementById("hero")?.getAttribute("data-status") || "offline";
      const mood = st === "go" ? "go" : st === "degraded" ? "warn" : st === "down" ? "down" : "idle";
      window.__signalSet?.({ energy: 0.2 + rate * 0.8, mood });
    } catch (e) {}
    renderWorkloads(overview.workloads);
    renderPods(pods);
    renderRuns(runList);
    renderRunStatus(runSt);
    $("report-link").style.display = overview.report_available ? "inline" : "none";
    $("pdf-link").style.display = overview.pdf_available ? "inline" : "none";
    if (overview.auth && overview.auth.enabled) {
      $("session").style.display = "inline";
      $("session-user").textContent = overview.auth.user;
    }
    await refreshDrawer();
    loadKnowledgeStatus();
    lastSync = Date.now();
  } catch (err) {
    $("sync").textContent = "sync failed: " + err;
  }
}
setInterval(() => {
  if (lastSync) $("sync").textContent = "synced " + rel((Date.now() - lastSync) / 1000 | 0) + " ago";
}, 1000);

let refreshTimer = null;
function setRefreshRate(ms) {
  if (refreshTimer) clearInterval(refreshTimer);
  refreshTimer = ms > 0 ? setInterval(() => { sync(); if (eventsOpen) loadEvents(); }, ms) : null;
}
$("refresh-rate").value = String(localStorage.getItem("zyvor-refresh") || REFRESH);
$("refresh-rate").addEventListener("change", () => {
  localStorage.setItem("zyvor-refresh", $("refresh-rate").value);
  setRefreshRate(parseInt($("refresh-rate").value, 10));
});
sync();
loadTestHealth();
loadSchedules();
loadFindings();
loadEngagements();
setInterval(loadSchedules, 15000);
setInterval(loadFindings, 15000);
setInterval(loadEngagements, 30000);
setRefreshRate(parseInt($("refresh-rate").value, 10) || REFRESH);


/* ========== Surprise systems ========== */
(function surpriseSystems() {
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const field = document.getElementById("signal-field");
  const splash = document.getElementById("boot-splash");
  const warp = document.getElementById("warp-flash");
  const achieve = document.getElementById("achieve-toast");
  if (!field) return;

  /* Boot cinematic */
  const lines = [
    "calibrating signal field…",
    "linking Playwright engines…",
    "warming Mission Control…",
    "all systems nominal",
  ];
  let li = 0;
  const bootSub = document.getElementById("boot-sub");
  const bootTimer = setInterval(() => {
    li++;
    if (bootSub && lines[li]) bootSub.textContent = lines[li];
    if (li >= lines.length - 1) clearInterval(bootTimer);
  }, 380);
  const dismissBoot = () => {
    if (!splash) return;
    splash.classList.add("hide");
    setTimeout(() => splash.remove(), 800);
  };
  setTimeout(dismissBoot, reduce ? 200 : 1750);
  splash?.addEventListener("click", dismissBoot);

  /* Live constellation — nodes pulse with pass-rate & busy jobs */
  const ctx = field.getContext("2d");
  let W = 0, H = 0, nodes = [], raf = 0;
  let energy = 0.35; // 0..1 from pass rate
  let busyPulse = 0;
  let mood = "idle"; // idle | go | warn | down | busy

  function resize() {
    W = field.width = innerWidth * devicePixelRatio;
    H = field.height = innerHeight * devicePixelRatio;
    field.style.width = innerWidth + "px";
    field.style.height = innerHeight + "px";
    ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
    const count = Math.min(72, Math.floor((innerWidth * innerHeight) / 28000));
    nodes = Array.from({ length: count }, (_, i) => ({
      x: Math.random() * innerWidth,
      y: Math.random() * innerHeight,
      vx: (Math.random() - 0.5) * 0.35,
      vy: (Math.random() - 0.5) * 0.35,
      r: 1.2 + Math.random() * 2.2,
      phase: Math.random() * Math.PI * 2,
      id: i,
    }));
  }
  resize();
  addEventListener("resize", resize);

  window.__signalSet = function (opts) {
    if (opts.energy != null) energy = Math.max(0.08, Math.min(1, opts.energy));
    if (opts.busy != null) busyPulse = opts.busy ? 1 : Math.max(0, busyPulse - 0.02);
    if (opts.mood) mood = opts.mood;
  };

  const palette = {
    idle: ["#3b82f6", "#38bdf8"],
    go: ["#22c55e", "#4ade80"],
    warn: ["#f59e0b", "#fbbf24"],
    down: ["#ef4444", "#fb7185"],
    busy: ["#a78bfa", "#38bdf8"],
  };

  function tick() {
    if (reduce) return;
    ctx.clearRect(0, 0, innerWidth, innerHeight);
    const cols = palette[mood] || palette.idle;
    const linkDist = 140 + energy * 80;
    if (busyPulse > 0) busyPulse *= 0.985;

    for (const n of nodes) {
      n.x += n.vx * (0.6 + energy);
      n.y += n.vy * (0.6 + energy);
      if (n.x < 0 || n.x > innerWidth) n.vx *= -1;
      if (n.y < 0 || n.y > innerHeight) n.vy *= -1;
      n.phase += 0.02 + energy * 0.03 + busyPulse * 0.04;
    }

    for (let i = 0; i < nodes.length; i++) {
      for (let j = i + 1; j < nodes.length; j++) {
        const a = nodes[i], b = nodes[j];
        const dx = a.x - b.x, dy = a.y - b.y;
        const d = Math.hypot(dx, dy);
        if (d < linkDist) {
          const alpha = (1 - d / linkDist) * (0.12 + energy * 0.28);
          ctx.strokeStyle = cols[0];
          ctx.globalAlpha = alpha;
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
        }
      }
    }

    for (const n of nodes) {
      const glow = n.r + Math.sin(n.phase) * 1.4 + busyPulse * 2;
      const g = ctx.createRadialGradient(n.x, n.y, 0, n.x, n.y, glow * 4);
      g.addColorStop(0, cols[1]);
      g.addColorStop(1, "transparent");
      ctx.globalAlpha = 0.22 + energy * 0.35;
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(n.x, n.y, glow * 4, 0, Math.PI * 2);
      ctx.fill();
      ctx.globalAlpha = 0.7 + energy * 0.3;
      ctx.fillStyle = cols[0];
      ctx.beginPath();
      ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;
    raf = requestAnimationFrame(tick);
  }
  if (!reduce) raf = requestAnimationFrame(tick);

  /* Achievement toasts */
  const unlocked = new Set(JSON.parse(localStorage.getItem("zyvor-achievements") || "[]"));
  function unlock(id, title, sub) {
    if (unlocked.has(id)) return;
    unlocked.add(id);
    localStorage.setItem("zyvor-achievements", JSON.stringify([...unlocked]));
    if (!achieve) return;
    document.getElementById("achieve-title").textContent = title;
    document.getElementById("achieve-sub").textContent = sub || "";
    achieve.classList.add("show");
    if (typeof beep === "function") beep(true);
    setTimeout(() => achieve.classList.remove("show"), 4200);
  }
  window.__unlockAchieve = unlock;
  setTimeout(() => unlock("boot", "First contact", "You opened Mission Control. The signal field is listening."), 2100);

  /* NOC mode — double-click brand */
  let noc = localStorage.getItem("zyvor-noc") === "1";
  function applyNoc() {
    document.body.classList.toggle("noc-mode", noc);
    const hint = document.querySelector(".topbar-hint");
    if (hint) hint.innerHTML = noc
      ? "<kbd>NOC</kbd> wall mode · double-click brand to exit"
      : "<kbd>⌘K</kbd> command palette";
  }
  applyNoc();
  document.querySelector(".topbar-brand")?.addEventListener("dblclick", () => {
    noc = !noc;
    localStorage.setItem("zyvor-noc", noc ? "1" : "0");
    applyNoc();
    warpFlash();
    unlock("noc", "NOC wall engaged", "Double-click the brand anytime to toggle ops wall mode.");
  });

  /* Warp flash — press ` or type zyvor */
  function warpFlash() {
    if (!warp || reduce) return;
    warp.classList.add("on");
    setTimeout(() => warp.classList.remove("on"), 180);
    // fling nodes
    for (const n of nodes) {
      n.vx += (Math.random() - 0.5) * 6;
      n.vy += (Math.random() - 0.5) * 6;
    }
    busyPulse = 1;
  }
  window.__warpFlash = warpFlash;

  let typed = "";
  document.addEventListener("keydown", (ev) => {
    if (/INPUT|TEXTAREA|SELECT/.test(document.activeElement?.tagName || "")) return;
    if (ev.key === "`") { warpFlash(); unlock("warp", "Warp jump", "Backtick tears a hole in the signal field."); return; }
    if (ev.key.length === 1 && /[a-z]/i.test(ev.key)) {
      typed = (typed + ev.key.toLowerCase()).slice(-5);
      if (typed === "zyvor") {
        typed = "";
        warpFlash();
        confettiBurst();
        unlock("zyvor", "Say my name", "You typed zyvor. Confetti is non-negotiable.");
      }
    }
  });

  /* Triple-click pulse icon → quantum theme */
  let clicks = 0, clickT = 0;
  document.querySelector(".icon-badge")?.addEventListener("click", () => {
    const now = Date.now();
    clicks = now - clickT < 600 ? clicks + 1 : 1;
    clickT = now;
    if (clicks >= 3) {
      clicks = 0;
      document.documentElement.style.setProperty("--accent", "#22d3ee");
      document.documentElement.style.setProperty("--accent-2", "#67e8f9");
      document.documentElement.style.setProperty("--accent-hot", "#a5f3fc");
      mood = "busy";
      energy = 1;
      warpFlash();
      unlock("quantum", "Quantum link", "Triple-click the pulse badge to shift the spectrum.");
    }
  });
})();

document.getElementById("topbar-palette")?.addEventListener("click", () => openPalette());
</script>
</body>
</html>
