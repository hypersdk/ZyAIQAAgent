<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Zyvor Argus — Route sweep</title>
<style>
  :root { --ok: #0ca30c; --bad: #d03b3b; --warn: #d08a1a; --ink: #f1f5f9; --ink2: #98989d; --line: rgba(255,255,255,0.1); --surface: #1a1a19; }
  * { box-sizing: border-box; }
  body { margin: 0; background: #0d0d0d; color: var(--ink); font-family: -apple-system, "Segoe UI", Inter, sans-serif; font-size: 14px; padding: 28px; }
  h1 { font-size: 20px; margin: 0 0 4px; }
  .meta { color: var(--ink2); font-size: 13px; margin-bottom: 20px; }
  .summary { display: flex; gap: 14px; margin-bottom: 22px; flex-wrap: wrap; }
  .tile { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 12px 18px; }
  .tile .k { color: var(--ink2); font-size: 12px; text-transform: uppercase; }
  .tile .v { font-size: 22px; font-weight: 700; }
  .pass { color: var(--ok); } .fail { color: var(--bad); } .warn { color: var(--warn); }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); font-size: 13px; vertical-align: top; }
  th { color: var(--ink2); }
  .chip { display: inline-block; padding: 1px 9px; border-radius: 999px; font-size: 11px; font-weight: 700; border: 1px solid currentColor; }
  img { max-width: 220px; border: 1px solid var(--line); border-radius: 8px; }
  code { font-family: ui-monospace, Menlo, monospace; font-size: 12px; }
  @media print { body { background: #fff; color: #111; } }
</style>
</head>
<body>
  <h1>Zyvor Argus — Route sweep</h1>
  <div class="meta">{{ url }} · {{ generated_at }}</div>
  <div class="summary">
    <div class="tile"><div class="k">Routes × viewports</div><div class="v">{{ rows | length }}</div></div>
    <div class="tile"><div class="k">Changed</div><div class="v {{ 'fail' if summary.fail_count else 'pass' }}">{{ summary.fail_count }}</div></div>
    <div class="tile"><div class="k">New baselines</div><div class="v">{{ summary.new_baselines }}</div></div>
  </div>
  <table>
    <tr><th>Route</th><th>Viewport</th><th>Status</th><th>Diff %</th><th>Screenshot</th></tr>
    {% for r in rows %}
    <tr>
      <td><code>{{ r.route }}</code></td>
      <td>{{ r.viewport }}</td>
      <td><span class="chip {{ 'fail' if r.status == 'fail' else ('warn' if r.status == 'baseline' else 'pass') }}">{{ r.status | upper }}</span></td>
      <td>{{ r.diff }}%</td>
      <td>{% if r.cur %}<img src="{{ r.cur }}" alt="{{ r.route }} {{ r.viewport }}">{% endif %}</td>
    </tr>
    {% endfor %}
  </table>
</body>
</html>
